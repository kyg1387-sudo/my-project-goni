 "lines": [
  {
   "id": "line201",
   "tag": "L201",
   "spk": "三好",
   "scene": "S13",
   "type": "dialogue",
   "ja": "……高橋。お前の名前だけは、書けなかった。",
   "lead": 0.0,
   "dur": 5.638,
   "start": 0.5,
   "end": 6.138
  },
  {
   "id": "line202",
   "tag": "L202",
   "spk": "高橋 健二(N)",
   "scene": "S13",
   "type": "narration",
   "ja": "壁に並んだ、七つの額。七つ目には――俺の名前があった。",
   "lead": 0.0,
   "dur": 4.952,
   "start": 6.938,
   "end": 11.89
  },
  {
   "id": "line203",
   "tag": "L203",
   "spk": "高橋 健二(N)",
   "scene": "S13",
   "type": "narration",
   "ja": "拾ったカードで、俺を捨てた連中は、一日でひざまずいた。",
   "lead": 0.043,
   "dur": 4.15,
   "start": 14.99,
   "end": 19.14
  },
  {
   "id": "line204",
   "tag": "L204",
   "spk": "高橋 健二(N)",
   "scene": "S13",
   "type": "narration",
   "ja": "だが、カードの持ち主は俺で七人目。前の六人は全員、消えている。",
   "lead": 0.033,
   "dur": 5.53,
   "start": 19.74,
   "end": 25.27
  },
  {
   "id": "line205",
   "tag": "L205",
   "spk": "声",
   "scene": "S13",
   "type": "dialogue",
   "ja": "\"次の名前\"を、お書きください。",
   "lead": 0.007,
   "dur": 1.621,
   "start": 26.07,
   "end": 27.691
  },
  {
   "id": "line206",
   "tag": "L206",
   "spk": "健二",
   "scene": "S14",
   "type": "dialogue",
   "ja": "……戻れ。蓮見商事だ。",
   "lead": 0.031,
   "dur": 1.265,
   "start": 35.991,
   "end": 37.256
  },
  {
   "id": "line208",
   "tag": "L208",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "十五年前の面接。答えがあるとすれば、あのビルの地下書庫だ。",
   "lead": 0.0,
   "dur": 5.073,
   "start": 38.056,
   "end": 43.129
  },
  {
   "id": "line209",
   "tag": "L209",
   "spk": "警備員",
   "scene": "S14",
   "type": "dialogue",
   "ja": "オ、オーナー……こんな時間に、どちらへ。",
   "lead": 0.04,
   "dur": 2.552,
   "start": 43.929,
   "end": 46.481
  },
  {
   "id": "line210",
   "tag": "L210",
   "spk": "健二",
   "scene": "S14",
   "type": "dialogue",
   "ja": "地下二階の書庫だ。鍵を。",
   "lead": 0.052,
   "dur": 2.846,
   "start": 47.281,
   "end": 50.127
  },
  {
   "id": "line211",
   "tag": "L211",
   "spk": "警備員",
   "scene": "S14",
   "type": "dialogue",
   "ja": "……先日は、社員証の件で、大変失礼をいたしました。",
   "lead": 0.073,
   "dur": 2.978,
   "start": 50.927,
   "end": 53.905
  },
  {
   "id": "line212",
   "tag": "L212",
   "spk": "健二",
   "scene": "S14",
   "type": "dialogue",
   "ja": "仕事だったんだろう。今夜も、頼む。",
   "lead": 0.0,
   "dur": 2.814,
   "start": 54.705,
   "end": 57.519
  },
  {
   "id": "line213",
   "tag": "L213",
   "spk": "警備員",
   "scene": "S14",
   "type": "dialogue",
   "ja": "あの書庫……先月、夜中に一人だけ入った方がいます。",
   "lead": 0.136,
   "dur": 5.384,
   "start": 58.319,
   "end": 63.703
  },
  {
   "id": "line214",
   "tag": "L214",
   "spk": "警備員",
   "scene": "S14",
   "type": "dialogue",
   "ja": "昔、人事にいらした方です。",
   "lead": 0.0,
   "dur": 1.829,
   "start": 64.303,
   "end": 66.132
  },
  {
   "id": "line215",
   "tag": "L215",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "十五年前の採用ファイル。同期は、三十人。",
   "lead": 0.0,
   "dur": 4.035,
   "start": 66.932,
   "end": 70.967
  },
  {
   "id": "line216",
   "tag": "L216",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "名前の横に、黒い印が七つ。六人は、墨で塗り潰されている。",
   "lead": 0.027,
   "dur": 4.927,
   "start": 74.067,
   "end": 78.994
  },
  {
   "id": "line217",
   "tag": "L217",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "墨の下の名前を、俺は全部覚えていた。",
   "lead": 0.001,
   "dur": 2.818,
   "start": 79.594,
   "end": 82.412
  },
  {
   "id": "line219",
   "tag": "L219",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "残った印の横には、俺の名前。そして\"No.7\"。",
   "lead": 0.0,
   "dur": 4.038,
   "start": 83.012,
   "end": 87.05
  },
  {
   "id": "line220",
   "tag": "L220",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "番号のインクだけが、まだ新しい。",
   "lead": 0.002,
   "dur": 2.333,
   "start": 87.65,
   "end": 89.983
  },
  {
   "id": "line221",
   "tag": "L221",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "先月だ。俺がクビになる、一か月前。",
   "lead": 0.084,
   "dur": 2.969,
   "start": 90.583,
   "end": 93.552
  },
  {
   "id": "line222",
   "tag": "L222",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "俺の面接評価票。総合、A。",
   "lead": 0.067,
   "dur": 2.416,
   "start": 94.552,
   "end": 96.968
  },
  {
   "id": "line223",
   "tag": "L223",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "それが線で消され、\"C\"に直されていた。",
   "lead": 0.114,
   "dur": 3.038,
   "start": 97.568,
   "end": 100.606
  },
  {
   "id": "line224",
   "tag": "L224",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "赤い判には、\"指示あり\"。その下に、あの紋章。",
   "lead": 0.0,
   "dur": 3.467,
   "start": 101.206,
   "end": 104.673
  },
  {
   "id": "line225",
   "tag": "L225",
   "spk": "柴田",
   "scene": "S14",
   "type": "dialogue",
   "ja": "高橋、お前は運がいいよな。ギリギリで受かったんだから。",
   "lead": 0.037,
   "dur": 3.318,
   "start": 105.473,
   "end": 108.791
  },
  {
   "id": "line226",
   "tag": "L226",
   "spk": "高橋 健二(N)",
   "scene": "S14",
   "type": "narration",
   "ja": "ギリギリじゃない。一番だった俺を、誰かが\"ギリギリ\"にしたんだ。",
   "lead": 0.0,
   "dur": 3.37,
   "start": 109.591,
   "end": 112.961
  },
  {
   "id": "line227",
   "tag": "L227",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "墨の下の六人は、全員\"希望退職\"だった。",
   "lead": 0.015,
   "dur": 3.338,
   "start": 113.961,
   "end": 117.299
  },
  {
   "id": "line228",
   "tag": "L228",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "承認の判は、六枚とも同じ。人事担当常務、永瀬。",
   "lead": 0.0,
   "dur": 4.865,
   "start": 117.899,
   "end": 122.764
  },
  {
   "id": "line229",
   "tag": "L229",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "そして全員、辞めた七日後に姿を消している。",
   "lead": 0.096,
   "dur": 3.467,
   "start": 123.364,
   "end": 126.831
  },
  {
   "id": "line230",
   "tag": "L230",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "辞めた日付を並べると、間隔はほぼ二年。",
   "lead": 0.018,
   "dur": 3.402,
   "start": 127.431,
   "end": 130.833
  },
  {
   "id": "line232",
   "tag": "L232",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "住民票は、役所が職権で消していた。",
   "lead": 0.0,
   "dur": 3.182,
   "start": 131.433,
   "end": 134.615
  },
  {
   "id": "line233",
   "tag": "L233",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "自分の意思で消えた大人を、警察は探さない。",
   "lead": 0.05,
   "dur": 3.21,
   "start": 135.215,
   "end": 138.425
  },
  {
   "id": "line234",
   "tag": "L234",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "六つ目のファイルで、手が止まった。三好達也。",
   "lead": 0.066,
   "dur": 4.127,
   "start": 141.525,
   "end": 145.652
  },
  {
   "id": "line235",
   "tag": "L235",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "社食でいつも、俺の向かいに座っていた男だ。",
   "lead": 0.13,
   "dur": 2.968,
   "start": 146.252,
   "end": 149.22
  },
  {
   "id": "line237",
   "tag": "L237",
   "spk": "高橋 健二(N)",
   "scene": "S15",
   "type": "narration",
   "ja": "二年前、田舎に帰ると笑って辞めた。",
   "lead": 0.041,
   "dur": 2.663,
   "start": 149.82,
   "end": 152.483
  },
  {
   "id": "line238",
   "tag": "L238",
   "spk": "案内音",
   "scene": "S15",
   "type": "dialogue",
   "ja": "おかけになった電話番号は、現在使われておりません。",
   "lead": 0.024,
   "dur": 3.378,
   "start": 153.283,
   "end": 156.661
  },
  {
   "id": "line239",
   "tag": "L239",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "高橋様。地下書庫のご利用を、確認いたしました。",
   "lead": 0.089,
   "dur": 3.496,
   "start": 158.461,
   "end": 161.957
  },
  {
   "id": "line240",
   "tag": "L240",
   "spk": "健二",
   "scene": "S16",
   "type": "dialogue",
   "ja": "……見ているのか。",
   "lead": 0.17,
   "dur": 0.768,
   "start": 162.757,
   "end": 163.525
  },
  {
   "id": "line241",
   "tag": "L241",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "ご質問は、お受けしておりません。",
   "lead": 0.031,
   "dur": 1.703,
   "start": 164.325,
   "end": 166.028
  },
  {
   "id": "line242",
   "tag": "L242",
   "spk": "健二",
   "scene": "S16",
   "type": "dialogue",
   "ja": "なら、要望だ。三好達也の最後の住所に、車を回せ。",
   "lead": 0.028,
   "dur": 4.244,
   "start": 166.828,
   "end": 171.072
  },
  {
   "id": "line243",
   "tag": "L243",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "承知いたしました。お車は、すでに地上にご用意しております。",
   "lead": 0.013,
   "dur": 4.229,
   "start": 171.872,
   "end": 176.101
  },
  {
   "id": "line244",
   "tag": "L244",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "それから一点、お伝えし忘れておりました。",
   "lead": 0.0,
   "dur": 2.286,
   "start": 176.701,
   "end": 178.987
  },
  {
   "id": "line245",
   "tag": "L245",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "期限の日の、午前零時まで。カードの裏に、\"次の名前\"をひとつお書きください。",
   "lead": 0.043,
   "dur": 6.054,
   "start": 179.587,
   "end": 185.641
  },
  {
   "id": "line246",
   "tag": "L246",
   "spk": "健二",
   "scene": "S16",
   "type": "dialogue",
   "ja": "次の名前？……誰の名前だ。",
   "lead": 0.002,
   "dur": 1.737,
   "start": 186.441,
   "end": 188.178
  },
  {
   "id": "line247",
   "tag": "L247",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "お決めになるのは、高橋様でございます。",
   "lead": 0.066,
   "dur": 2.299,
   "start": 188.978,
   "end": 191.277
  },
  {
   "id": "line248",
   "tag": "L248",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "先の六名様は、どなたもお書きになりませんでした。",
   "lead": 0.002,
   "dur": 3.343,
   "start": 191.877,
   "end": 195.22
  },
  {
   "id": "line249",
   "tag": "L249",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "ですので――すべてを、精算させていただきました。",
   "lead": 0.051,
   "dur": 2.427,
   "start": 195.82,
   "end": 198.247
  },
  {
   "id": "line250",
   "tag": "L250",
   "spk": "健二",
   "scene": "S16",
   "type": "dialogue",
   "ja": "……すべて、とは。",
   "lead": 0.038,
   "dur": 1.165,
   "start": 199.047,
   "end": 200.212
  },
  {
   "id": "line251",
   "tag": "L251",
   "spk": "声",
   "scene": "S16",
   "type": "dialogue",
   "ja": "すべて、でございます。",
   "lead": 0.038,
   "dur": 1.164,
   "start": 201.012,
   "end": 202.176
  },
  {
   "id": "line252",
   "tag": "L252",
   "spk": "高橋 健二(N)",
   "scene": "S16",
   "type": "narration",
   "ja": "\"すべて\"。その意味を、六時間後――三好の部屋で知ることになる。",
   "lead": 0.0,
   "dur": 5.131,
   "start": 204.176,
   "end": 209.307
  },
  {
   "id": "line253",
   "tag": "L253",
   "spk": "運転手",
   "scene": "S17",
   "type": "dialogue",
   "ja": "鍵も、お預かりしております。",
   "lead": 0.051,
   "dur": 1.704,
   "start": 213.807,
   "end": 215.511
  },
  {
   "id": "line254",
   "tag": "L254",
   "spk": "健二",
   "scene": "S17",
   "type": "dialogue",
   "ja": "……なぜ、お前が鍵を持っている。",
   "lead": 0.095,
   "dur": 2.017,
   "start": 216.311,
   "end": 218.328
  },
  {
   "id": "line255",
   "tag": "L255",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "何もなかった。家具も、服も、暮らしの匂いも。",
   "lead": 0.0,
   "dur": 5.181,
   "start": 219.128,
   "end": 224.309
  },
  {
   "id": "line256",
   "tag": "L256",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "荒らされたんじゃない。最初から誰もいなかったみたいに、拭き取られている。",
   "lead": 0.034,
   "dur": 4.111,
   "start": 224.909,
   "end": 229.02
  },
  {
   "id": "line257",
   "tag": "L257",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "壁のカレンダーは、二年前の三月で止まっていた。",
   "lead": 0.0,
   "dur": 2.839,
   "start": 229.62,
   "end": 232.459
  },
  {
   "id": "line258",
   "tag": "L258",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "七つの日付に、赤い丸。最後の一つだけが、黒く塗られている。",
   "lead": 0.0,
   "dur": 5.101,
   "start": 233.059,
   "end": 238.16
  },
  {
   "id": "line259",
   "tag": "L259",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "机の上には、半分に切られたカード。そして、古いICレコーダー。",
   "lead": 0.024,
   "dur": 6.072,
   "start": 241.26,
   "end": 247.332
  },
  {
   "id": "line260",
   "tag": "L260",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "……高橋。これ聞いてるってことは、お前が七番目か。",
   "lead": 0.028,
   "dur": 4.084,
   "start": 248.132,
   "end": 252.216
  },
  {
   "id": "line261",
   "tag": "L261",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "俺もさ、拾ったんだよ。辞めた日の夜に、同じカード。",
   "lead": 0.0,
   "dur": 3.657,
   "start": 252.816,
   "end": 256.473
  },
  {
   "id": "line262",
   "tag": "L262",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "七日間、夢みたいだった。でも最後の夜、名前を一つ書けって言われてさ。",
   "lead": 0.029,
   "dur": 6.525,
   "start": 257.073,
   "end": 263.598
  },
  {
   "id": "line263",
   "tag": "L263",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "書けば、全部俺のものになる。……リストに残ってたのは、お前だけだった。",
   "lead": 0.104,
   "dur": 7.35,
   "start": 264.198,
   "end": 271.548
  },
  {
   "id": "line264",
   "tag": "L264",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "社食の唐揚げ、いつも一個くれたよな。……あれ、うまかったなあ。",
   "lead": 0.0,
   "dur": 6.476,
   "start": 272.148,
   "end": 278.624
  },
  {
   "id": "line265",
   "tag": "L265",
   "spk": "三好",
   "scene": "S17",
   "type": "dialogue",
   "ja": "……ごめんな。お前の名前だけは、書けなかった。",
   "lead": 0.026,
   "dur": 3.233,
   "start": 279.224,
   "end": 282.457
  },
  {
   "id": "line266",
   "tag": "L266",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "最後に会った日。三好は何か言いかけて、笑ってごまかした。",
   "lead": 0.099,
   "dur": 3.358,
   "start": 283.457,
   "end": 286.815
  },
  {
   "id": "line267",
   "tag": "L267",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "あの日の言葉の続きが、これだった。",
   "lead": 0.07,
   "dur": 2.591,
   "start": 287.415,
   "end": 290.006
  },
  {
   "id": "line268",
   "tag": "L268",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "三好は、俺を売らなかった。",
   "lead": 0.0,
   "dur": 2.133,
   "start": 290.606,
   "end": 292.739
  },
  {
   "id": "line269",
   "tag": "L269",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "その代わりに、家も、名前も、この世にいた証拠も、全部なくした。",
   "lead": 0.002,
   "dur": 5.19,
   "start": 293.339,
   "end": 298.529
  },
  {
   "id": "line270",
   "tag": "L270",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "\"精算\"とは、そういうことだった。",
   "lead": 0.026,
   "dur": 1.933,
   "start": 299.129,
   "end": 301.062
  },
  {
   "id": "line271",
   "tag": "L271",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "三好を消した書類に、判を押した男がいる。",
   "lead": 0.0,
   "dur": 2.763,
   "start": 301.662,
   "end": 304.425
  },
  {
   "id": "line272",
   "tag": "L272",
   "spk": "高橋 健二(N)",
   "scene": "S17",
   "type": "narration",
   "ja": "そいつは今も――俺の会社で、常務の椅子に座っている。",
   "lead": 0.0,
   "dur": 3.789,
   "start": 305.025,
   "end": 308.814
  },
  {
   "id": "line273",
   "tag": "L273",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "高橋……さん。お呼びでしょうか。",
   "lead": 0.022,
   "dur": 2.798,
   "start": 309.814,
   "end": 312.612
  },
  {
   "id": "line274",
   "tag": "L274",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "十二年で、六人。全部、あなたの判だ。",
   "lead": 0.0,
   "dur": 3.331,
   "start": 313.412,
   "end": 316.743
  },
  {
   "id": "line275",
   "tag": "L275",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "規定どおりの手続きですよ。何か問題でも。",
   "lead": 0.053,
   "dur": 4.75,
   "start": 317.543,
   "end": 322.293
  },
  {
   "id": "line276",
   "tag": "L276",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "六人とも、辞めて七日後に消えている。",
   "lead": 0.03,
   "dur": 3.247,
   "start": 323.093,
   "end": 326.34
  },
  {
   "id": "line277",
   "tag": "L277",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "……偶然でしょう。",
   "lead": 0.086,
   "dur": 0.889,
   "start": 327.14,
   "end": 328.029
  },
  {
   "id": "line278",
   "tag": "L278",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "それに、私を切れば、この会社の人事は止まりますよ。",
   "lead": 0.025,
   "dur": 3.557,
   "start": 328.629,
   "end": 332.186
  },
  {
   "id": "line279",
   "tag": "L279",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "止まればいい。十五年、人を沈めてきた歯車だ。",
   "lead": 0.034,
   "dur": 3.773,
   "start": 332.986,
   "end": 336.759
  },
  {
   "id": "line280",
   "tag": "L280",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "七枚目は、俺の分だ。……八枚目に、あなたの名前が載らなきゃいいがな。",
   "lead": 0.012,
   "dur": 4.379,
   "start": 337.359,
   "end": 341.738
  },
  {
   "id": "line281",
   "tag": "L281",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "……脅しているおつもりですか。",
   "lead": 0.0,
   "dur": 1.676,
   "start": 342.538,
   "end": 344.214
  },
  {
   "id": "line282",
   "tag": "L282",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "株主は今、俺一人だ。あなたを切るのに、会議はいらない。",
   "lead": 0.028,
   "dur": 3.935,
   "start": 345.014,
   "end": 348.949
  },
  {
   "id": "line283",
   "tag": "L283",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "切られる前に書け。誰の指示だった。",
   "lead": 0.041,
   "dur": 2.399,
   "start": 349.549,
   "end": 351.948
  },
  {
   "id": "line284",
   "tag": "L284",
   "spk": "健二",
   "scene": "S18",
   "type": "dialogue",
   "ja": "判子は――ここ。",
   "lead": 0.104,
   "dur": 1.128,
   "start": 352.548,
   "end": 353.676
  },
  {
   "id": "line285",
   "tag": "L285",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "……鷺沼さんです。当時の、人事部長の。",
   "lead": 0.052,
   "dur": 3.379,
   "start": 355.176,
   "end": 358.555
  },
  {
   "id": "line286",
   "tag": "L286",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "私は、紋章の入った封筒を受け取っていただけで……",
   "lead": 0.155,
   "dur": 3.434,
   "start": 359.155,
   "end": 362.589
  },
  {
   "id": "line286b",
   "tag": "L286b",
   "spk": "永瀬",
   "scene": "S18",
   "type": "dialogue",
   "ja": "社長は、何も知りません。封筒が来たら、判を押すだけです。",
   "lead": 0.079,
   "dur": 4.731,
   "start": 363.189,
   "end": 367.92
  },
  {
   "id": "line287",
   "tag": "L287",
   "spk": "高橋 健二(N)",
   "scene": "S18",
   "type": "narration",
   "ja": "俺の十五年を沈めた判子は、封筒ひとつで買われていた。",
   "lead": 0.021,
   "dur": 4.018,
   "start": 368.72,
   "end": 372.738
  },
  {
   "id": "line289",
   "tag": "L289",
   "spk": "高橋 健二(N)",
   "scene": "S18",
   "type": "narration",
   "ja": "鷺沼。その男を探す前に、携帯に美咲からの着信が十二件、溜まっていた。",
   "lead": 0.035,
   "dur": 5.825,
   "start": 373.338,
   "end": 379.163
  },
  {
   "id": "line290",
   "tag": "L290",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "健二……お願い、話だけ聞いて。",
   "lead": 0.102,
   "dur": 2.951,
   "start": 380.163,
   "end": 383.114
  },
  {
   "id": "line291",
   "tag": "L291",
   "spk": "健二",
   "scene": "S19",
   "type": "dialogue",
   "ja": "君の欄は、もう空いてない。",
   "lead": 0.074,
   "dur": 1.822,
   "start": 383.914,
   "end": 385.736
  },
  {
   "id": "line292",
   "tag": "L292",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "違うの、お金じゃないの。……柴田が、いなくなったの。",
   "lead": 0.069,
   "dur": 4.125,
   "start": 386.536,
   "end": 390.661
  },
  {
   "id": "line293",
   "tag": "L293",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "あの人、毎月こういう封筒をもらってた。あなたの話をするときだけ、楽しそうに笑って。",
   "lead": 0.09,
   "dur": 6.618,
   "start": 391.261,
   "end": 397.879
  },
  {
   "id": "line294",
   "tag": "L294",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "おととい、最後のが届いたの。中は、紙が一枚だけ。",
   "lead": 0.088,
   "dur": 4.517,
   "start": 398.479,
   "end": 402.996
  },
  {
   "id": "line295",
   "tag": "L295",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "\"任務終了\"って、書いてあった。",
   "lead": 0.048,
   "dur": 2.39,
   "start": 403.596,
   "end": 405.986
  },
  {
   "id": "line296",
   "tag": "L296",
   "spk": "美咲",
   "scene": "S19",
   "type": "dialogue",
   "ja": "その夜から、帰ってこない。……健二、あなた何に巻き込まれてるの？",
   "lead": 0.05,
   "dur": 5.514,
   "start": 406.586,
   "end": 412.1
  },
  {
   "id": "line298",
   "tag": "L298",
   "spk": "高橋 健二(N)",
   "scene": "S19",
   "type": "narration",
   "ja": "柴田は、俺の\"見張り\"だった。そして、用済みになった見張りは――消される。",
   "lead": 0.0,
   "dur": 4.724,
   "start": 412.9,
   "end": 417.624
  },
  {
   "id": "line299",
   "tag": "L299",
   "spk": "高橋 健二(N)",
   "scene": "S19",
   "type": "narration",
   "ja": "なら、十五年前に見張りを付けた男にも――もう、時間がない。",
   "lead": 0.0,
   "dur": 4.644,
   "start": 418.224,
   "end": 422.868
  },
  {
   "id": "line300",
   "tag": "L300",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "……来たか。七番目。",
   "lead": 0.084,
   "dur": 1.444,
   "start": 430.368,
   "end": 431.812
  },
  {
   "id": "line301",
   "tag": "L301",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "私にも今朝、届いたよ。\"任務終了\"だ。",
   "lead": 0.0,
   "dur": 3.429,
   "start": 432.412,
   "end": 435.841
  },
  {
   "id": "line302",
   "tag": "L302",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "……だから、全部話す。",
   "lead": 0.178,
   "dur": 1.504,
   "start": 436.441,
   "end": 437.945
  },
  {
   "id": "line303",
   "tag": "L303",
   "spk": "健二",
   "scene": "S20",
   "type": "dialogue",
   "ja": "先月、書庫で俺の名前の横に\"7\"を書いたのは、あなたか。",
   "lead": 0.0,
   "dur": 4.29,
   "start": 438.745,
   "end": 443.035
  },
  {
   "id": "line304",
   "tag": "L304",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "ああ。最後の仕事だった。",
   "lead": 0.0,
   "dur": 1.829,
   "start": 443.835,
   "end": 445.664
  },
  {
   "id": "line305",
   "tag": "L305",
   "spk": "健二",
   "scene": "S20",
   "type": "dialogue",
   "ja": "十五年前、俺の評価をCにしたのも。",
   "lead": 0.0,
   "dur": 3.048,
   "start": 446.464,
   "end": 449.512
  },
  {
   "id": "line306",
   "tag": "L306",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "書き換えたのは私だ。決めたのは、私じゃない。",
   "lead": 0.044,
   "dur": 3.362,
   "start": 450.312,
   "end": 453.674
  },
  {
   "id": "line307",
   "tag": "L307",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "あの年、面接の上位七人に印をつけろと言われた。",
   "lead": 0.056,
   "dur": 3.814,
   "start": 454.274,
   "end": 458.088
  },
  {
   "id": "line308",
   "tag": "L308",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "真面目で、辛抱強くて、恨みを口に出さない男だけをな。",
   "lead": 0.039,
   "dur": 4.001,
   "start": 458.688,
   "end": 462.689
  },
  {
   "id": "line309",
   "tag": "L309",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "出世させず、辞めさせず。壊れた順に、番号を振っていく。",
   "lead": 0.0,
   "dur": 4.571,
   "start": 463.289,
   "end": 467.86
  },
  {
   "id": "line310",
   "tag": "L310",
   "spk": "健二",
   "scene": "S20",
   "type": "dialogue",
   "ja": "……壊れた順。",
   "lead": 0.061,
   "dur": 1.076,
   "start": 468.66,
   "end": 469.736
  },
  {
   "id": "line311",
   "tag": "L311",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "君だけは、十五年経っても壊れなかった。だから先月――壊すことに決まった。",
   "lead": 0.048,
   "dur": 5.974,
   "start": 470.536,
   "end": 476.51
  },
  {
   "id": "line312",
   "tag": "L312",
   "spk": "健二",
   "scene": "S20",
   "type": "dialogue",
   "ja": "あの夜、裏口にカードを落としたのも、あなたか。",
   "lead": 0.0,
   "dur": 2.663,
   "start": 477.31,
   "end": 479.973
  },
  {
   "id": "line313",
   "tag": "L313",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "ああ。……持ち主に言われてな。",
   "lead": 0.0,
   "dur": 2.093,
   "start": 480.773,
   "end": 482.866
  },
  {
   "id": "line314",
   "tag": "L314",
   "spk": "健二",
   "scene": "S20",
   "type": "dialogue",
   "ja": "……持ち主は、誰だ。",
   "lead": 0.031,
   "dur": 1.57,
   "start": 483.666,
   "end": 485.236
  },
  {
   "id": "line315",
   "tag": "L315",
   "spk": "鷺沼",
   "scene": "S20",
   "type": "dialogue",
   "ja": "最上階へ行け。あの部屋の椅子に誰が座っているか、自分の目で確かめるといい。",
   "lead": 0.004,
   "dur": 5.771,
   "start": 486.736,
   "end": 492.507
  },
  {
   "id": "line316",
   "tag": "L316",
   "spk": "高橋 健二(N)",
   "scene": "S20",
   "type": "narration",
   "ja": "あの夜、声が俺の名前を知っていたわけだ。十五年前から、リストの最後に載っていたんだから。",
   "lead": 0.028,
   "dur": 5.677,
   "start": 493.307,
   "end": 498.984
  },
  {
   "id": "line317",
   "tag": "L317",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "ビルのオーナーは、俺だ。だが最上階だけは、登記上、別の人間のものだった。",
   "lead": 0.038,
   "dur": 5.887,
   "start": 502.484,
   "end": 508.371
  },
  {
   "id": "line318",
   "tag": "L318",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "俺の鍵では、開かない。",
   "lead": 0.057,
   "dur": 1.647,
   "start": 508.971,
   "end": 510.618
  },
  {
   "id": "line319",
   "tag": "L319",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "六つの額には、半分に切られたカード。その下に、No.1からNo.6の名前。",
   "lead": 0.051,
   "dur": 5.79,
   "start": 512.618,
   "end": 518.408
  },
  {
   "id": "line320",
   "tag": "L320",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "七つ目は、空っぽのまま俺を待っていた。",
   "lead": 0.032,
   "dur": 2.505,
   "start": 521.508,
   "end": 524.013
  },
  {
   "id": "line321",
   "tag": "L321",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "机の上のコーヒーから――まだ、湯気が立っていた。",
   "lead": 0.052,
   "dur": 3.681,
   "start": 524.613,
   "end": 528.294
  },
  {
   "id": "line322",
   "tag": "L322",
   "spk": "高橋 健二(N)",
   "scene": "S21",
   "type": "narration",
   "ja": "カップの横に、俺宛ての封筒が一通。",
   "lead": 0.065,
   "dur": 2.826,
   "start": 529.794,
   "end": 532.62
  },
  {
   "id": "line323",
   "tag": "L323",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "中身は、\"所有権継承契約書\"。",
   "lead": 0.038,
   "dur": 3.503,
   "start": 536.12,
   "end": 539.623
  },
  {
   "id": "line324",
   "tag": "L324",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "期限の日、候補者は、現所有者のすべてを継承する。",
   "lead": 0.0,
   "dur": 4.36,
   "start": 540.223,
   "end": 544.583
  },
  {
   "id": "line325",
   "tag": "L325",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "条件は一つ。次の候補者を、一人指名すること。",
   "lead": 0.0,
   "dur": 4.038,
   "start": 545.183,
   "end": 549.221
  },
  {
   "id": "line326",
   "tag": "L326",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "精算は、取り立てなんかじゃなかった。この椅子の――引き継ぎだった。",
   "lead": 0.108,
   "dur": 4.015,
   "start": 549.821,
   "end": 553.836
  },
  {
   "id": "line327",
   "tag": "L327",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "俺と同じ十五年の地獄を、誰か一人に背負わせる。",
   "lead": 0.035,
   "dur": 3.929,
   "start": 554.436,
   "end": 558.365
  },
  {
   "id": "line329",
   "tag": "L329",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "署名欄には、もう俺の名前が刷られていた。空いているのは、\"次の候補者\"の欄だけ。",
   "lead": 0.004,
   "dur": 4.964,
   "start": 558.965,
   "end": 563.929
  },
  {
   "id": "line330",
   "tag": "L330",
   "spk": "美咲",
   "scene": "S22",
   "type": "dialogue",
   "ja": "あなたの欄だけ、空けておいたから。",
   "lead": 0.046,
   "dur": 1.997,
   "start": 564.729,
   "end": 566.726
  },
  {
   "id": "line331",
   "tag": "L331",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "そして、現所有者の署名欄には――",
   "lead": 0.07,
   "dur": 2.015,
   "start": 567.526,
   "end": 569.541
  },
  {
   "id": "line332",
   "tag": "L332",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "蓮見宗一郎。蓮見商事の、創業者。",
   "lead": 0.116,
   "dur": 3.426,
   "start": 570.341,
   "end": 573.767
  },
  {
   "id": "line333",
   "tag": "L333",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "十年前、社葬で俺も焼香した男の名前だった。",
   "lead": 0.082,
   "dur": 4.316,
   "start": 574.367,
   "end": 578.683
  },
  {
   "id": "line334",
   "tag": "L334",
   "spk": "健二",
   "scene": "S22",
   "type": "dialogue",
   "ja": "要望だ。蓮見宗一郎の、今の居場所を調べろ。",
   "lead": 0.001,
   "dur": 3.395,
   "start": 579.483,
   "end": 582.878
  },
  {
   "id": "line335",
   "tag": "L335",
   "spk": "声",
   "scene": "S22",
   "type": "dialogue",
   "ja": "……申し訳ございません。そのご要望だけは、お受けいたしかねます。",
   "lead": 0.044,
   "dur": 4.423,
   "start": 583.678,
   "end": 588.101
  },
  {
   "id": "line336",
   "tag": "L336",
   "spk": "高橋 健二(N)",
   "scene": "S22",
   "type": "narration",
   "ja": "初めてだった。このカードが、\"できない\"と言ったのは。",
   "lead": 0.0,
   "dur": 3.048,
   "start": 588.901,
   "end": 591.949
  },
  {
   "id": "line337",
   "tag": "L337",
   "spk": "運転手",
   "scene": "S23",
   "type": "dialogue",
   "ja": "六人とも、あの部屋から戻られたとき、同じお顔をなさっていました。",
   "lead": 0.038,
   "dur": 4.074,
   "start": 595.449,
   "end": 599.523
  },
  {
   "id": "line338",
   "tag": "L338",
   "spk": "健二",
   "scene": "S23",
   "type": "dialogue",
   "ja": "……お前は、何者だ。",
   "lead": 0.094,
   "dur": 1.739,
   "start": 600.323,
   "end": 602.062
  },
  {
   "id": "line339",
   "tag": "L339",
   "spk": "運転手",
   "scene": "S23",
   "type": "dialogue",
   "ja": "No.5様を最後にお乗せしたのも、この車でございます。",
   "lead": 0.034,
   "dur": 3.473,
   "start": 602.862,
   "end": 606.335
  },
  {
   "id": "line340",
   "tag": "L340",
   "spk": "健二",
   "scene": "S23",
   "type": "dialogue",
   "ja": "書く名前なら――もう、決めてある。",
   "lead": 0.026,
   "dur": 2.108,
   "start": 607.135,
   "end": 609.243
  },
  {
   "id": "line341",
   "tag": "L341",
   "spk": "No.1",
   "scene": "S24",
   "type": "dialogue",
   "ja": "高橋健二だな。……俺は、No.1だ。",
   "lead": 0.066,
   "dur": 4.051,
   "start": 611.043,
   "end": 615.094
  },
  {
   "id": "line342",
   "tag": "L342",
   "spk": "No.1",
   "scene": "S24",
   "type": "dialogue",
   "ja": "横浜で待ってる。期限の前に、来い。",
   "lead": 0.0,
   "dur": 3.346,
   "start": 615.694,
   "end": 619.04
  },
  {
   "id": "line343",
   "tag": "L343",
   "spk": "高橋 健二(N)",
   "scene": "S24",
   "type": "narration",
   "ja": "残り――五日。",
   "lead": 0.132,
   "dur": 1.397,
   "start": 620.04,
   "end": 621.437
  }
 ]
}