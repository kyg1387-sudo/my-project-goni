 "lines": [
  {
   "id": "line001",
   "scene": "S01",
   "spk": "富子",
   "omni": false,
   "start": 2.5,
   "end": 7.994875,
   "dur": 5.494875,
   "text": "若菜さん……お願い。戻ってきて"
  },
  {
   "id": "line002",
   "scene": "S01",
   "spk": "若菜",
   "omni": true,
   "start": 8.794875000000001,
   "end": 13.321000000000002,
   "dur": 4.526125,
   "text": "よそ者の嫁は、裏方で十分なんでしょう？"
  },
  {
   "id": "line003",
   "scene": "S01",
   "spk": "NA1",
   "omni": false,
   "start": 17.321,
   "end": 22.680937500000002,
   "dur": 5.3599375,
   "text": "下働き。それが、嫁いで五年の私の肩書きだった。"
  },
  {
   "id": "line004",
   "scene": "S01",
   "spk": "NA2",
   "omni": false,
   "start": 23.280937500000004,
   "end": 31.838562500000002,
   "dur": 8.557625,
   "text": "繁忙期の三日前、私は旅館を去った。……百年の暖簾に、何が起きたのか。"
  },
  {
   "id": "line005",
   "scene": "S02",
   "spk": "NA3",
   "omni": false,
   "start": 38.8385625,
   "end": 43.912375000000004,
   "dur": 5.0738125,
   "text": "私は若菜、三十三歳。東京の外資系ホテルで働いていた。"
  },
  {
   "id": "line006",
   "scene": "S02",
   "spk": "NA4",
   "omni": false,
   "start": 44.512375000000006,
   "end": 48.075187500000006,
   "dur": 3.5628124999999997,
   "text": "隆之さんと出会い、温泉街の老舗「月見荘」に嫁いだ。"
  },
  {
   "id": "line007",
   "scene": "S02",
   "spk": "NA5",
   "omni": false,
   "start": 51.075187500000006,
   "end": 56.47525,
   "dur": 5.400062500000001,
   "text": "朝は四時に起きて、朝食の仕込み。昼は予約サイトと、海外のお客様の対応。"
  },
  {
   "id": "line008",
   "scene": "S03",
   "spk": "NA6",
   "omni": false,
   "start": 59.37525,
   "end": 63.418375,
   "dur": 4.043125,
   "text": "英語と中国語ができるのは、この旅館で私だけ。"
  },
  {
   "id": "line009",
   "scene": "S03",
   "spk": "NA7",
   "omni": false,
   "start": 64.01837499999999,
   "end": 71.21074999999999,
   "dur": 7.192375,
   "text": "海外の旅行会社との契約を、一から作った。外国人のお客様は、五年で十倍になった。"
  },
  {
   "id": "line010",
   "scene": "S03",
   "spk": "常連客",
   "omni": false,
   "start": 75.01074999999999,
   "end": 79.28275,
   "dur": 4.272,
   "text": "若菜さんの顔を見ると、来た気がするんだよ"
  },
  {
   "id": "line011",
   "scene": "S03",
   "spk": "若菜",
   "omni": true,
   "start": 80.08274999999999,
   "end": 83.10874999999999,
   "dur": 3.0260000000000002,
   "text": "お帰りなさいませ。今年も、お待ちしておりました"
  },
  {
   "id": "line012",
   "scene": "S04",
   "spk": "富子",
   "omni": true,
   "start": 87.40874999999998,
   "end": 92.05131249999998,
   "dur": 4.6425625,
   "text": "お給料？ 家族なんだから、当然でしょう"
  },
  {
   "id": "line013",
   "scene": "S04",
   "spk": "富子",
   "omni": false,
   "start": 92.65131249999997,
   "end": 97.21443749999997,
   "dur": 4.563125,
   "text": "麻衣は別よ。あの子は、外で働いていたんだから"
  },
  {
   "id": "line014",
   "scene": "S04",
   "spk": "NA8",
   "omni": false,
   "start": 101.21443749999997,
   "end": 105.83849999999997,
   "dur": 4.6240625,
   "text": "嫁いで五年。私の給料は、一円もなかった。"
  },
  {
   "id": "line015",
   "scene": "S05",
   "spk": "若菜",
   "omni": true,
   "start": 108.33849999999997,
   "end": 113.15512499999997,
   "dur": 4.816625,
   "text": "隆之さん。……せめて、お義姉さんと同じようにお給料を"
  },
  {
   "id": "line016",
   "scene": "S05",
   "spk": "隆之",
   "omni": true,
   "start": 113.95512499999997,
   "end": 118.09087499999997,
   "dur": 4.13575,
   "text": "母さんに逆らうなよ。お前はうちの嫁なんだから"
  },
  {
   "id": "line017",
   "scene": "S05",
   "spk": "隆之",
   "omni": false,
   "start": 118.69087499999996,
   "end": 120.76399999999997,
   "dur": 2.073125,
   "text": "黙って手伝ってればいいんだって"
  },
  {
   "id": "line018",
   "scene": "S05",
   "spk": "NA9",
   "omni": false,
   "start": 124.76399999999997,
   "end": 130.49606249999997,
   "dur": 5.7320625,
   "text": "夜十一時、帳簿を閉じる。それが、私の一日だった。"
  },
  {
   "id": "line019",
   "scene": "S06",
   "spk": "富子",
   "omni": true,
   "start": 135.99606249999997,
   "end": 140.78087499999995,
   "dur": 4.7848125,
   "text": "皆さま、こちらが当館の若女将、娘の麻衣でございます"
  },
  {
   "id": "line020",
   "scene": "S06",
   "spk": "富子",
   "omni": false,
   "start": 141.38087499999995,
   "end": 145.08887499999994,
   "dur": 3.708,
   "text": "……あちらは下働きの者ですので、お気になさらず"
  },
  {
   "id": "line021",
   "scene": "S06",
   "spk": "NA10",
   "omni": false,
   "start": 149.08887499999994,
   "end": 152.58599999999996,
   "dur": 3.497125,
   "text": "お客様の前で、私は「下働き」になった。"
  },
  {
   "id": "line022",
   "scene": "S07",
   "spk": "富子",
   "omni": true,
   "start": 155.58599999999996,
   "end": 160.97006249999995,
   "dur": 5.384062500000001,
   "text": "来月から、予約もお客様の対応も、全部麻衣に任せます"
  },
  {
   "id": "line023",
   "scene": "S07",
   "spk": "富子",
   "omni": false,
   "start": 161.57006249999995,
   "end": 165.51787499999995,
   "dur": 3.9478125,
   "text": "若菜さん、あなたは厨房と掃除だけでいいわ"
  },
  {
   "id": "line024",
   "scene": "S07",
   "spk": "若菜",
   "omni": true,
   "start": 168.31787499999996,
   "end": 173.76706249999995,
   "dur": 5.4491875,
   "text": "でも……海外の旅行会社とのやり取りは、私でないと――"
  },
  {
   "id": "line025",
   "scene": "S07",
   "spk": "麻衣",
   "omni": true,
   "start": 174.56706249999996,
   "end": 178.18918749999997,
   "dur": 3.622125,
   "text": "はあ？ 英語なんて、翻訳アプリで十分でしょ"
  },
  {
   "id": "line026",
   "scene": "S07",
   "spk": "麻衣",
   "omni": true,
   "start": 178.78918749999997,
   "end": 185.58262499999998,
   "dur": 6.7934375000000005,
   "text": "よそ者の嫁は裏方で十分なのよ。あんたの代わりなんて、いくらでもいるんだから"
  },
  {
   "id": "line027",
   "scene": "S07",
   "spk": "富子",
   "omni": true,
   "start": 190.58262499999998,
   "end": 193.57956249999998,
   "dur": 2.9969375,
   "text": "そうよ。嫌なら、出て行けばいいわ"
  },
  {
   "id": "line028",
   "scene": "S07",
   "spk": "富子",
   "omni": false,
   "start": 194.17956249999997,
   "end": 199.06337499999998,
   "dur": 4.8838124999999994,
   "text": "月見荘はね、あなたがいなくても、百年やってきたんですから"
  },
  {
   "id": "line029",
   "scene": "S07",
   "spk": "NA11",
   "omni": false,
   "start": 203.56337499999998,
   "end": 207.31612499999997,
   "dur": 3.75275,
   "text": "その言葉を聞いた瞬間、不思議と、胸のつかえが取れた。"
  },
  {
   "id": "line030",
   "scene": "S07",
   "spk": "若菜",
   "omni": true,
   "start": 208.81612499999997,
   "end": 211.44868749999998,
   "dur": 2.6325624999999997,
   "text": "……分かりました。では、そうさせていただきます"
  },
  {
   "id": "line031",
   "scene": "S07",
   "spk": "NA12",
   "omni": false,
   "start": 214.94868749999998,
   "end": 217.63718749999998,
   "dur": 2.6885000000000003,
   "text": "……その言葉が、すべての始まりだった。"
  },
  {
   "id": "line032",
   "scene": "S08",
   "spk": "NA13",
   "omni": false,
   "start": 222.0371875,
   "end": 224.93643749999998,
   "dur": 2.89925,
   "text": "私は、五十ページの引き継ぎ書を残した。"
  },
  {
   "id": "line033",
   "scene": "S08",
   "spk": "NA14",
   "omni": false,
   "start": 225.53643749999998,
   "end": 232.65518749999998,
   "dur": 7.1187499999999995,
   "text": "予約サイトの管理方法。海外の担当者と、アレルギー対応が必要な常連のお客様。"
  },
  {
   "id": "line034",
   "scene": "S08",
   "spk": "NA15",
   "omni": false,
   "start": 235.65518749999998,
   "end": 243.00743749999998,
   "dur": 7.35225,
   "text": "旅館に損をさせるつもりは、なかった。……それをどう使うかは、あの人たち次第だった。"
  },
  {
   "id": "line035",
   "scene": "S09",
   "spk": "麻衣",
   "omni": true,
   "start": 244.00743749999998,
   "end": 246.45774999999998,
   "dur": 2.4503125,
   "text": "こんなの、読まなくても分かるわよ"
  },
  {
   "id": "line036",
   "scene": "S09",
   "spk": "麻衣",
   "omni": false,
   "start": 247.05774999999997,
   "end": 251.87387499999997,
   "dur": 4.8161249999999995,
   "text": "旅館のことは、私の方がずっと詳しいんだから"
  },
  {
   "id": "line037",
   "scene": "S10",
   "spk": "NA16",
   "omni": false,
   "start": 256.373875,
   "end": 264.56625,
   "dur": 8.192375,
   "text": "私がいなくなって、五日。最初に崩れたのは、予約だった。"
  },
  {
   "id": "line038",
   "scene": "S10",
   "spk": "NA17",
   "omni": false,
   "start": 265.16625000000005,
   "end": 271.87293750000003,
   "dur": 6.7066875,
   "text": "義姉は在庫設定を理解していなかった。同じ部屋に、二組のお客様を入れてしまった。"
  },
  {
   "id": "line039",
   "scene": "S10",
   "spk": "麻衣",
   "omni": false,
   "start": 276.17293750000005,
   "end": 279.46731250000005,
   "dur": 3.294375,
   "text": "で、ですから、システムの不具合で……！"
  },
  {
   "id": "line040",
   "scene": "S10",
   "spk": "NA18",
   "omni": false,
   "start": 280.26731250000006,
   "end": 287.85875000000004,
   "dur": 7.5914375000000005,
   "text": "海外からのメールは、翻訳アプリでは返せなかった。返事のない予約は、次々と消えていった。"
  },
  {
   "id": "line041",
   "scene": "S11",
   "spk": "NA19",
   "omni": false,
   "start": 291.95875000000007,
   "end": 298.51475000000005,
   "dur": 6.556,
   "text": "次は、常連のお客様の食事。そば粉アレルギーの方の膳に、そば茶が出された。"
  },
  {
   "id": "line042",
   "scene": "S11",
   "spk": "NA20",
   "omni": false,
   "start": 299.1147500000001,
   "end": 306.23468750000006,
   "dur": 7.1199375,
   "text": "幸い大事には至らなかった。……引き継ぎ書の三ページ目に、赤字で書いてあったことだった。"
  },
  {
   "id": "line043",
   "scene": "S11",
   "spk": "富子",
   "omni": true,
   "start": 310.8346875000001,
   "end": 313.7530000000001,
   "dur": 2.9183125000000003,
   "text": "麻衣！ 一体、どうなってるの！"
  },
  {
   "id": "line044",
   "scene": "S11",
   "spk": "麻衣",
   "omni": true,
   "start": 314.5530000000001,
   "end": 319.8851875000001,
   "dur": 5.3321875,
   "text": "わ、私のせいじゃないわよ！ システムが分かりにくいのが悪いのよ！"
  },
  {
   "id": "line045",
   "scene": "S11",
   "spk": "富子",
   "omni": false,
   "start": 320.8851875000001,
   "end": 323.8017500000001,
   "dur": 2.9165625,
   "text": "あのお客様は、二十年の常連なのよ……！"
  },
  {
   "id": "line046",
   "scene": "S12",
   "spk": "NA21",
   "omni": false,
   "start": 329.6017500000001,
   "end": 336.77293750000007,
   "dur": 7.1711875,
   "text": "月見荘を出た翌週。温泉街一の旅館「花筏」の桜井社長から、連絡をいただいた。"
  },
  {
   "id": "line047",
   "scene": "S12",
   "spk": "桜井",
   "omni": true,
   "start": 337.5729375000001,
   "end": 341.4789375000001,
   "dur": 3.906,
   "text": "若菜さん。うちの支配人になってくれない？"
  },
  {
   "id": "line048",
   "scene": "S12",
   "spk": "桜井",
   "omni": true,
   "start": 342.0789375000001,
   "end": 349.6385625000001,
   "dur": 7.559625,
   "text": "お給料は、前の職場の……あら、ゼロだったわね。じゃあ、あなたが決めて"
  },
  {
   "id": "line049",
   "scene": "S12",
   "spk": "NA22",
   "omni": false,
   "start": 353.2385625000001,
   "end": 356.90606250000013,
   "dur": 3.6675,
   "text": "前からずっと、私の仕事を見ていてくださったのだという。"
  },
  {
   "id": "line050",
   "scene": "S13",
   "spk": "NA23",
   "omni": false,
   "start": 360.40606250000013,
   "end": 367.12431250000014,
   "dur": 6.718249999999999,
   "text": "繁忙期、初日。その電話は、朝一番にかかってきた。"
  },
  {
   "id": "line051",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 370.32431250000013,
   "end": 373.20725000000016,
   "dur": 2.8829375,
   "text": "月見荘さんですか。台湾の旅行社の、陳です"
  },
  {
   "id": "line052",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 373.8072500000002,
   "end": 378.7658125000002,
   "dur": 4.9585625,
   "text": "来月からの三か月分。毎週の団体予約を、すべてキャンセルいたします"
  },
  {
   "id": "line053",
   "scene": "S13",
   "spk": "富子",
   "omni": true,
   "start": 379.5658125000002,
   "end": 383.3974375000002,
   "dur": 3.831625,
   "text": "キャ、キャンセル！？ ……どうして、ですか！"
  },
  {
   "id": "line054",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 384.1974375000002,
   "end": 389.2780000000002,
   "dur": 5.0805625,
   "text": "私たちが信頼して契約したのは、月見荘さんではありません。若菜さんです"
  },
  {
   "id": "line055",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 389.8780000000002,
   "end": 393.3782500000002,
   "dur": 3.50025,
   "text": "彼女のいない旅館に、お客様はお送りできません"
  },
  {
   "id": "line056",
   "scene": "S13",
   "spk": "NA24",
   "omni": false,
   "start": 399.3782500000002,
   "end": 403.1898125000002,
   "dur": 3.8115625000000004,
   "text": "団体キャンセルの損失は、三か月で二千万円を超えた。"
  },
  {
   "id": "line057",
   "scene": "S13",
   "spk": "NA25",
   "omni": false,
   "start": 403.7898125000002,
   "end": 410.4421875000002,
   "dur": 6.652375,
   "text": "売り上げの四割は、私が作った海外ルート。それを支えていたのが「下働きの嫁」だった。"
  },
  {
   "id": "line058",
   "scene": "S13",
   "spk": "NA26",
   "omni": false,
   "start": 414.04218750000024,
   "end": 422.27718750000025,
   "dur": 8.235,
   "text": "義母はその夜、ゴミ箱から引き継ぎ書を拾い上げた。……三ページ目は、赤字だった。"
  },
  {
   "id": "line059",
   "scene": "S13",
   "spk": "NA27",
   "omni": false,
   "start": 426.3771875000003,
   "end": 428.8421250000003,
   "dur": 2.4649375,
   "text": "そして、その頃――私は。"
  },
  {
   "id": "line060",
   "scene": "S14",
   "spk": "NA28",
   "omni": false,
   "start": 434.24212500000027,
   "end": 437.27950000000027,
   "dur": 3.037375,
   "text": "陳さんのことは、私からは何も言っていない。"
  },
  {
   "id": "line061",
   "scene": "S14",
   "spk": "NA29",
   "omni": false,
   "start": 437.8795000000003,
   "end": 444.4659375000003,
   "dur": 6.5864375,
   "text": "「若菜さんがいる宿に送る」。それは、陳さんがご自分で決めたことだった。"
  },
  {
   "id": "line062",
   "scene": "S15",
   "spk": "常連客",
   "omni": false,
   "start": 449.7659375000003,
   "end": 453.4288125000003,
   "dur": 3.662875,
   "text": "若菜さんがこっちにいると聞いてねえ"
  },
  {
   "id": "line063",
   "scene": "S15",
   "spk": "常連客",
   "omni": false,
   "start": 454.0288125000003,
   "end": 458.8290000000003,
   "dur": 4.8001875,
   "text": "わしらは、宿じゃなくて、人に会いに来とるんだよ"
  },
  {
   "id": "line064",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 465.6290000000003,
   "end": 469.9188750000003,
   "dur": 4.289874999999999,
   "text": "……お義姉さん。うちで働きたい、ですか"
  },
  {
   "id": "line065",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 470.5188750000003,
   "end": 474.5104375000003,
   "dur": 3.9915625000000006,
   "text": "申し訳ありませんが、あなたの代わりなら、いくらでもいますから"
  },
  {
   "id": "line066",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 475.11043750000033,
   "end": 477.14868750000034,
   "dur": 2.03825,
   "text": "――では、どうぞ、代わりの方と"
  },
  {
   "id": "line067",
   "scene": "S17",
   "spk": "NA30",
   "omni": false,
   "start": 486.44868750000035,
   "end": 490.13781250000034,
   "dur": 3.6891249999999998,
   "text": "責任を押し付けられることを恐れた義姉は、旅館を捨てて逃げた。"
  },
  {
   "id": "line068",
   "scene": "S17",
   "spk": "NA31",
   "omni": false,
   "start": 490.73781250000036,
   "end": 498.7376250000004,
   "dur": 7.999812499999999,
   "text": "私は五年分の働きを、財産分与として請求した。離婚は、正式に成立した。"
  },
  {
   "id": "line069",
   "scene": "S17",
   "spk": "NA32",
   "omni": false,
   "start": 499.3376250000004,
   "end": 501.9161250000004,
   "dur": 2.5785,
   "text": "夫からの電話には、一度も出なかった。"
  },
  {
   "id": "line070",
   "scene": "S17",
   "spk": "NA33",
   "omni": false,
   "start": 506.9161250000004,
   "end": 510.6240000000004,
   "dur": 3.707875,
   "text": "義母は一人で、百年の帳場に座っていた。"
  },
  {
   "id": "line071",
   "scene": "S18",
   "spk": "富子",
   "omni": true,
   "start": 515.1240000000005,
   "end": 520.6188750000005,
   "dur": 5.494875,
   "text": "若菜さん……お願い。戻ってきて"
  },
  {
   "id": "line072",
   "scene": "S18",
   "spk": "富子",
   "omni": true,
   "start": 521.2188750000005,
   "end": 528.7585000000005,
   "dur": 7.539625,
   "text": "私が、間違ってたわ。月見荘が……百年の暖簾が……"
  },
  {
   "id": "line073",
   "scene": "S18",
   "spk": "隆之",
   "omni": false,
   "start": 529.5585000000004,
   "end": 532.3654375000004,
   "dur": 2.8069375,
   "text": "若菜！ 頼む、母さんの言う通りに――"
  },
  {
   "id": "line074",
   "scene": "S18",
   "spk": "若菜",
   "omni": true,
   "start": 535.8654375000004,
   "end": 541.8731250000004,
   "dur": 6.0076875,
   "text": "お義母さん。月見荘は、私がいなくても百年やってきたんですよね"
  },
  {
   "id": "line075",
   "scene": "S18",
   "spk": "若菜",
   "omni": true,
   "start": 542.4731250000004,
   "end": 546.9992500000004,
   "dur": 4.526125,
   "text": "……それに。よそ者の嫁は、裏方で十分なんでしょう？"
  },
  {
   "id": "line076",
   "scene": "S18",
   "spk": "NA34",
   "omni": false,
   "start": 552.9992500000004,
   "end": 558.5862500000004,
   "dur": 5.587,
   "text": "「代わりはいくらでもいる」。そう扱う場所に、かけがえのないものは残らない。"
  },
  {
   "id": "line077",
   "scene": "S18",
   "spk": "NA35",
   "omni": false,
   "start": 562.6862500000004,
   "end": 568.0351250000004,
   "dur": 5.348875,
   "text": "私は今、私を必要としてくれる場所で、毎日お客様を迎えている。"
  },
  {
   "id": "line078",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 587.0351250000004,
   "end": 589.7569375000005,
   "dur": 2.7218125000000004,
   "text": "ご視聴ありがとうございました。美談ものがたりです"
  },
  {
   "id": "line079",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 590.3569375000005,
   "end": 595.4010625000005,
   "dur": 5.044124999999999,
   "text": "スカッとした方は、高評価とチャンネル登録を、お願いします"
  },
  {
   "id": "line080",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 596.0010625000006,
   "end": 600.7759375000005,
   "dur": 4.774875000000001,
   "text": "皆様が若菜さんなら、月見荘に戻りますか？ コメントで教えてください"
  },
  {
   "id": "line081",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 601.3759375000005,
   "end": 607.3536875000005,
   "dur": 5.97775,
   "text": "次回は、「同窓会で私を笑った元同級生が、面接室に来た話」です"
  },
  {
   "id": "line082",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 607.9536875000006,
   "end": 609.7991250000006,
   "dur": 1.8454375,
   "text": "それでは、また次の物語で"
  }
 ]
}