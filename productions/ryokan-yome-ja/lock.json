 "lines": [
  {
   "id": "line001",
   "scene": "S01",
   "spk": "富子",
   "omni": false,
   "start": 2.5,
   "end": 8.7745625,
   "dur": 6.2745625,
   "text": "若菜さん……お願い。戻ってきて"
  },
  {
   "id": "line002",
   "scene": "S01",
   "spk": "若菜",
   "omni": true,
   "start": 9.5745625,
   "end": 14.100687500000001,
   "dur": 4.526125,
   "text": "よそ者の嫁は、裏方で十分なんでしょう？"
  },
  {
   "id": "line003",
   "scene": "S01",
   "spk": "NA1",
   "omni": false,
   "start": 18.1006875,
   "end": 23.460625,
   "dur": 5.3599375,
   "text": "下働き。それが、嫁いで五年の私の肩書きだった。"
  },
  {
   "id": "line004",
   "scene": "S01",
   "spk": "NA2",
   "omni": false,
   "start": 24.060625,
   "end": 32.61825,
   "dur": 8.557625,
   "text": "繁忙期の三日前、私は旅館を去った。……百年の暖簾に、何が起きたのか。"
  },
  {
   "id": "line005",
   "scene": "S02",
   "spk": "NA3",
   "omni": false,
   "start": 39.61825,
   "end": 44.692062500000006,
   "dur": 5.0738125,
   "text": "私は若菜、三十三歳。東京の外資系ホテルで働いていた。"
  },
  {
   "id": "line006",
   "scene": "S02",
   "spk": "NA4",
   "omni": false,
   "start": 45.29206250000001,
   "end": 48.85487500000001,
   "dur": 3.5628124999999997,
   "text": "隆之さんと出会い、温泉街の老舗「月見荘」に嫁いだ。"
  },
  {
   "id": "line007",
   "scene": "S02",
   "spk": "NA5",
   "omni": false,
   "start": 51.85487500000001,
   "end": 57.25493750000001,
   "dur": 5.400062500000001,
   "text": "朝は四時に起きて、朝食の仕込み。昼は予約サイトと、海外のお客様の対応。"
  },
  {
   "id": "line008",
   "scene": "S03",
   "spk": "NA6",
   "omni": false,
   "start": 60.15493750000001,
   "end": 64.1980625,
   "dur": 4.043125,
   "text": "英語と中国語ができるのは、この旅館で私だけ。"
  },
  {
   "id": "line009",
   "scene": "S03",
   "spk": "NA7",
   "omni": false,
   "start": 64.7980625,
   "end": 71.9904375,
   "dur": 7.192375,
   "text": "海外の旅行会社との契約を、一から作った。外国人のお客様は、五年で十倍になった。"
  },
  {
   "id": "line010",
   "scene": "S03",
   "spk": "常連客",
   "omni": false,
   "start": 75.7904375,
   "end": 80.0624375,
   "dur": 4.272,
   "text": "若菜さんの顔を見ると、来た気がするんだよ"
  },
  {
   "id": "line011",
   "scene": "S03",
   "spk": "若菜",
   "omni": true,
   "start": 80.8624375,
   "end": 83.8884375,
   "dur": 3.0260000000000002,
   "text": "お帰りなさいませ。今年も、お待ちしておりました"
  },
  {
   "id": "line012",
   "scene": "S04",
   "spk": "富子",
   "omni": true,
   "start": 88.18843749999999,
   "end": 92.83099999999999,
   "dur": 4.6425625,
   "text": "お給料？ 家族なんだから、当然でしょう"
  },
  {
   "id": "line013",
   "scene": "S04",
   "spk": "富子",
   "omni": false,
   "start": 93.43099999999998,
   "end": 97.99412499999998,
   "dur": 4.563125,
   "text": "麻衣は別よ。あの子は、外で働いていたんだから"
  },
  {
   "id": "line014",
   "scene": "S04",
   "spk": "NA8",
   "omni": false,
   "start": 101.99412499999998,
   "end": 106.61818749999998,
   "dur": 4.6240625,
   "text": "嫁いで五年。私の給料は、一円もなかった。"
  },
  {
   "id": "line015",
   "scene": "S05",
   "spk": "若菜",
   "omni": true,
   "start": 109.11818749999998,
   "end": 113.93481249999998,
   "dur": 4.816625,
   "text": "隆之さん。……せめて、お義姉さんと同じようにお給料を"
  },
  {
   "id": "line016",
   "scene": "S05",
   "spk": "隆之",
   "omni": true,
   "start": 114.73481249999998,
   "end": 118.87056249999998,
   "dur": 4.13575,
   "text": "母さんに逆らうなよ。お前はうちの嫁なんだから"
  },
  {
   "id": "line017",
   "scene": "S05",
   "spk": "隆之",
   "omni": false,
   "start": 119.47056249999997,
   "end": 121.54368749999998,
   "dur": 2.073125,
   "text": "黙って手伝ってればいいんだって"
  },
  {
   "id": "line018",
   "scene": "S05",
   "spk": "NA9",
   "omni": false,
   "start": 125.54368749999998,
   "end": 131.27575,
   "dur": 5.7320625,
   "text": "夜十一時、帳簿を閉じる。それが、私の一日だった。"
  },
  {
   "id": "line019",
   "scene": "S06",
   "spk": "富子",
   "omni": true,
   "start": 136.77575,
   "end": 141.56056249999997,
   "dur": 4.7848125,
   "text": "皆さま、こちらが当館の若女将、娘の麻衣でございます"
  },
  {
   "id": "line020",
   "scene": "S06",
   "spk": "富子",
   "omni": false,
   "start": 142.16056249999997,
   "end": 145.86856249999997,
   "dur": 3.708,
   "text": "……あちらは下働きの者ですので、お気になさらず"
  },
  {
   "id": "line021",
   "scene": "S06",
   "spk": "NA10",
   "omni": false,
   "start": 149.86856249999997,
   "end": 153.36568749999998,
   "dur": 3.497125,
   "text": "お客様の前で、私は「下働き」になった。"
  },
  {
   "id": "line022",
   "scene": "S07",
   "spk": "富子",
   "omni": true,
   "start": 156.36568749999998,
   "end": 161.74974999999998,
   "dur": 5.384062500000001,
   "text": "来月から、予約もお客様の対応も、全部麻衣に任せます"
  },
  {
   "id": "line023",
   "scene": "S07",
   "spk": "富子",
   "omni": false,
   "start": 162.34974999999997,
   "end": 166.29756249999997,
   "dur": 3.9478125,
   "text": "若菜さん、あなたは厨房と掃除だけでいいわ"
  },
  {
   "id": "line024",
   "scene": "S07",
   "spk": "若菜",
   "omni": true,
   "start": 169.09756249999998,
   "end": 174.54674999999997,
   "dur": 5.4491875,
   "text": "でも……海外の旅行会社とのやり取りは、私でないと――"
  },
  {
   "id": "line025",
   "scene": "S07",
   "spk": "麻衣",
   "omni": true,
   "start": 175.34675,
   "end": 178.968875,
   "dur": 3.622125,
   "text": "はあ？ 英語なんて、翻訳アプリで十分でしょ"
  },
  {
   "id": "line026",
   "scene": "S07",
   "spk": "麻衣",
   "omni": true,
   "start": 179.568875,
   "end": 186.3623125,
   "dur": 6.7934375000000005,
   "text": "よそ者の嫁は裏方で十分なのよ。あんたの代わりなんて、いくらでもいるんだから"
  },
  {
   "id": "line027",
   "scene": "S07",
   "spk": "富子",
   "omni": true,
   "start": 191.3623125,
   "end": 194.35925,
   "dur": 2.9969375,
   "text": "そうよ。嫌なら、出て行けばいいわ"
  },
  {
   "id": "line028",
   "scene": "S07",
   "spk": "富子",
   "omni": false,
   "start": 194.95925,
   "end": 199.8430625,
   "dur": 4.8838124999999994,
   "text": "月見荘はね、あなたがいなくても、百年やってきたんですから"
  },
  {
   "id": "line029",
   "scene": "S07",
   "spk": "NA11",
   "omni": false,
   "start": 204.3430625,
   "end": 208.0958125,
   "dur": 3.75275,
   "text": "その言葉を聞いた瞬間、不思議と、胸のつかえが取れた。"
  },
  {
   "id": "line030",
   "scene": "S07",
   "spk": "若菜",
   "omni": true,
   "start": 209.5958125,
   "end": 212.228375,
   "dur": 2.6325624999999997,
   "text": "……分かりました。では、そうさせていただきます"
  },
  {
   "id": "line031",
   "scene": "S07",
   "spk": "NA12",
   "omni": false,
   "start": 215.728375,
   "end": 218.416875,
   "dur": 2.6885000000000003,
   "text": "……その言葉が、すべての始まりだった。"
  },
  {
   "id": "line032",
   "scene": "S08",
   "spk": "NA13",
   "omni": false,
   "start": 222.816875,
   "end": 225.716125,
   "dur": 2.89925,
   "text": "私は、五十ページの引き継ぎ書を残した。"
  },
  {
   "id": "line033",
   "scene": "S08",
   "spk": "NA14",
   "omni": false,
   "start": 226.316125,
   "end": 233.434875,
   "dur": 7.1187499999999995,
   "text": "予約サイトの管理方法。海外の担当者と、アレルギー対応が必要な常連のお客様。"
  },
  {
   "id": "line034",
   "scene": "S08",
   "spk": "NA15",
   "omni": false,
   "start": 236.434875,
   "end": 243.787125,
   "dur": 7.35225,
   "text": "旅館に損をさせるつもりは、なかった。……それをどう使うかは、あの人たち次第だった。"
  },
  {
   "id": "line035",
   "scene": "S09",
   "spk": "麻衣",
   "omni": true,
   "start": 244.787125,
   "end": 247.2374375,
   "dur": 2.4503125,
   "text": "こんなの、読まなくても分かるわよ"
  },
  {
   "id": "line036",
   "scene": "S09",
   "spk": "麻衣",
   "omni": false,
   "start": 247.8374375,
   "end": 252.6535625,
   "dur": 4.8161249999999995,
   "text": "旅館のことは、私の方がずっと詳しいんだから"
  },
  {
   "id": "line037",
   "scene": "S10",
   "spk": "NA16",
   "omni": false,
   "start": 257.1535625,
   "end": 265.34593750000005,
   "dur": 8.192375,
   "text": "私がいなくなって、五日。最初に崩れたのは、予約だった。"
  },
  {
   "id": "line038",
   "scene": "S10",
   "spk": "NA17",
   "omni": false,
   "start": 265.94593750000007,
   "end": 272.65262500000006,
   "dur": 6.7066875,
   "text": "義姉は在庫設定を理解していなかった。同じ部屋に、二組のお客様を入れてしまった。"
  },
  {
   "id": "line039",
   "scene": "S10",
   "spk": "麻衣",
   "omni": false,
   "start": 276.95262500000007,
   "end": 280.24700000000007,
   "dur": 3.294375,
   "text": "で、ですから、システムの不具合で……！"
  },
  {
   "id": "line040",
   "scene": "S10",
   "spk": "NA18",
   "omni": false,
   "start": 281.0470000000001,
   "end": 288.63843750000007,
   "dur": 7.5914375000000005,
   "text": "海外からのメールは、翻訳アプリでは返せなかった。返事のない予約は、次々と消えていった。"
  },
  {
   "id": "line041",
   "scene": "S11",
   "spk": "NA19",
   "omni": false,
   "start": 292.7384375000001,
   "end": 299.2944375000001,
   "dur": 6.556,
   "text": "次は、常連のお客様の食事。そば粉アレルギーの方の膳に、そば茶が出された。"
  },
  {
   "id": "line042",
   "scene": "S11",
   "spk": "NA20",
   "omni": false,
   "start": 299.8944375000001,
   "end": 307.0143750000001,
   "dur": 7.1199375,
   "text": "幸い大事には至らなかった。……引き継ぎ書の三ページ目に、赤字で書いてあったことだった。"
  },
  {
   "id": "line043",
   "scene": "S11",
   "spk": "富子",
   "omni": true,
   "start": 311.6143750000001,
   "end": 314.5326875000001,
   "dur": 2.9183125000000003,
   "text": "麻衣！ 一体、どうなってるの！"
  },
  {
   "id": "line044",
   "scene": "S11",
   "spk": "麻衣",
   "omni": true,
   "start": 315.33268750000013,
   "end": 320.6648750000001,
   "dur": 5.3321875,
   "text": "わ、私のせいじゃないわよ！ システムが分かりにくいのが悪いのよ！"
  },
  {
   "id": "line045",
   "scene": "S11",
   "spk": "富子",
   "omni": false,
   "start": 321.6648750000001,
   "end": 324.5814375000001,
   "dur": 2.9165625,
   "text": "あのお客様は、二十年の常連なのよ……！"
  },
  {
   "id": "line046",
   "scene": "S12",
   "spk": "NA21",
   "omni": false,
   "start": 330.3814375000001,
   "end": 337.5526250000001,
   "dur": 7.1711875,
   "text": "月見荘を出た翌週。温泉街一の旅館「花筏」の桜井社長から、連絡をいただいた。"
  },
  {
   "id": "line047",
   "scene": "S12",
   "spk": "桜井",
   "omni": true,
   "start": 338.3526250000001,
   "end": 342.2586250000001,
   "dur": 3.906,
   "text": "若菜さん。うちの支配人になってくれない？"
  },
  {
   "id": "line048",
   "scene": "S12",
   "spk": "桜井",
   "omni": true,
   "start": 342.85862500000013,
   "end": 350.4182500000001,
   "dur": 7.559625,
   "text": "お給料は、前の職場の……あら、ゼロだったわね。じゃあ、あなたが決めて"
  },
  {
   "id": "line049",
   "scene": "S12",
   "spk": "NA22",
   "omni": false,
   "start": 354.01825000000014,
   "end": 357.68575000000016,
   "dur": 3.6675,
   "text": "前からずっと、私の仕事を見ていてくださったのだという。"
  },
  {
   "id": "line050",
   "scene": "S13",
   "spk": "NA23",
   "omni": false,
   "start": 361.18575000000016,
   "end": 367.90400000000017,
   "dur": 6.718249999999999,
   "text": "繁忙期、初日。その電話は、朝一番にかかってきた。"
  },
  {
   "id": "line051",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 371.10400000000016,
   "end": 373.9869375000002,
   "dur": 2.8829375,
   "text": "月見荘さんですか。台湾の旅行社の、陳です"
  },
  {
   "id": "line052",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 374.5869375000002,
   "end": 379.54550000000023,
   "dur": 4.9585625,
   "text": "来月からの三か月分。毎週の団体予約を、すべてキャンセルいたします"
  },
  {
   "id": "line053",
   "scene": "S13",
   "spk": "富子",
   "omni": true,
   "start": 380.34550000000024,
   "end": 384.1771250000002,
   "dur": 3.831625,
   "text": "キャ、キャンセル！？ ……どうして、ですか！"
  },
  {
   "id": "line054",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 384.9771250000002,
   "end": 390.0576875000002,
   "dur": 5.0805625,
   "text": "私たちが信頼して契約したのは、月見荘さんではありません。若菜さんです"
  },
  {
   "id": "line055",
   "scene": "S13",
   "spk": "陳",
   "omni": false,
   "start": 390.65768750000024,
   "end": 394.15793750000023,
   "dur": 3.50025,
   "text": "彼女のいない旅館に、お客様はお送りできません"
  },
  {
   "id": "line056",
   "scene": "S13",
   "spk": "NA24",
   "omni": false,
   "start": 400.15793750000023,
   "end": 403.9695000000002,
   "dur": 3.8115625000000004,
   "text": "団体キャンセルの損失は、三か月で二千万円を超えた。"
  },
  {
   "id": "line057",
   "scene": "S13",
   "spk": "NA25",
   "omni": false,
   "start": 404.56950000000023,
   "end": 411.22187500000024,
   "dur": 6.652375,
   "text": "売り上げの四割は、私が作った海外ルート。それを支えていたのが「下働きの嫁」だった。"
  },
  {
   "id": "line058",
   "scene": "S13",
   "spk": "NA26",
   "omni": false,
   "start": 414.82187500000026,
   "end": 423.0568750000003,
   "dur": 8.235,
   "text": "義母はその夜、ゴミ箱から引き継ぎ書を拾い上げた。……三ページ目は、赤字だった。"
  },
  {
   "id": "line059",
   "scene": "S13",
   "spk": "NA27",
   "omni": false,
   "start": 427.1568750000003,
   "end": 429.6218125000003,
   "dur": 2.4649375,
   "text": "そして、その頃――私は。"
  },
  {
   "id": "line060",
   "scene": "S14",
   "spk": "NA28",
   "omni": false,
   "start": 435.0218125000003,
   "end": 438.0591875000003,
   "dur": 3.037375,
   "text": "陳さんのことは、私からは何も言っていない。"
  },
  {
   "id": "line061",
   "scene": "S14",
   "spk": "NA29",
   "omni": false,
   "start": 438.6591875000003,
   "end": 445.2456250000003,
   "dur": 6.5864375,
   "text": "「若菜さんがいる宿に送る」。それは、陳さんがご自分で決めたことだった。"
  },
  {
   "id": "line062",
   "scene": "S15",
   "spk": "常連客",
   "omni": false,
   "start": 450.5456250000003,
   "end": 454.2085000000003,
   "dur": 3.662875,
   "text": "若菜さんがこっちにいると聞いてねえ"
  },
  {
   "id": "line063",
   "scene": "S15",
   "spk": "常連客",
   "omni": false,
   "start": 454.8085000000003,
   "end": 459.6086875000003,
   "dur": 4.8001875,
   "text": "わしらは、宿じゃなくて、人に会いに来とるんだよ"
  },
  {
   "id": "line064",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 466.4086875000003,
   "end": 470.6985625000003,
   "dur": 4.289874999999999,
   "text": "……お義姉さん。うちで働きたい、ですか"
  },
  {
   "id": "line065",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 471.29856250000034,
   "end": 475.29012500000033,
   "dur": 3.9915625000000006,
   "text": "申し訳ありませんが、あなたの代わりなら、いくらでもいますから"
  },
  {
   "id": "line066",
   "scene": "S16",
   "spk": "若菜",
   "omni": true,
   "start": 475.89012500000035,
   "end": 477.92837500000036,
   "dur": 2.03825,
   "text": "――では、どうぞ、代わりの方と"
  },
  {
   "id": "line067",
   "scene": "S17",
   "spk": "NA30",
   "omni": false,
   "start": 487.22837500000037,
   "end": 490.91750000000036,
   "dur": 3.6891249999999998,
   "text": "責任を押し付けられることを恐れた義姉は、旅館を捨てて逃げた。"
  },
  {
   "id": "line068",
   "scene": "S17",
   "spk": "NA31",
   "omni": false,
   "start": 491.5175000000004,
   "end": 499.5173125000004,
   "dur": 7.999812499999999,
   "text": "私は五年分の働きを、財産分与として請求した。離婚は、正式に成立した。"
  },
  {
   "id": "line069",
   "scene": "S17",
   "spk": "NA32",
   "omni": false,
   "start": 500.1173125000004,
   "end": 502.69581250000044,
   "dur": 2.5785,
   "text": "夫からの電話には、一度も出なかった。"
  },
  {
   "id": "line070",
   "scene": "S17",
   "spk": "NA33",
   "omni": false,
   "start": 507.69581250000044,
   "end": 511.40368750000044,
   "dur": 3.707875,
   "text": "義母は一人で、百年の帳場に座っていた。"
  },
  {
   "id": "line071",
   "scene": "S18",
   "spk": "富子",
   "omni": true,
   "start": 515.9036875000004,
   "end": 522.1782500000004,
   "dur": 6.2745625,
   "text": "若菜さん……お願い。戻ってきて"
  },
  {
   "id": "line072",
   "scene": "S18",
   "spk": "富子",
   "omni": true,
   "start": 522.7782500000004,
   "end": 530.3178750000004,
   "dur": 7.539625,
   "text": "私が、間違ってたわ。月見荘が……百年の暖簾が……"
  },
  {
   "id": "line073",
   "scene": "S18",
   "spk": "隆之",
   "omni": false,
   "start": 531.1178750000004,
   "end": 533.9248125000004,
   "dur": 2.8069375,
   "text": "若菜！ 頼む、母さんの言う通りに――"
  },
  {
   "id": "line074",
   "scene": "S18",
   "spk": "若菜",
   "omni": true,
   "start": 537.4248125000004,
   "end": 543.4325000000003,
   "dur": 6.0076875,
   "text": "お義母さん。月見荘は、私がいなくても百年やってきたんですよね"
  },
  {
   "id": "line075",
   "scene": "S18",
   "spk": "若菜",
   "omni": true,
   "start": 544.0325000000004,
   "end": 548.5586250000003,
   "dur": 4.526125,
   "text": "……それに。よそ者の嫁は、裏方で十分なんでしょう？"
  },
  {
   "id": "line076",
   "scene": "S18",
   "spk": "NA34",
   "omni": false,
   "start": 554.5586250000003,
   "end": 560.1456250000003,
   "dur": 5.587,
   "text": "「代わりはいくらでもいる」。そう扱う場所に、かけがえのないものは残らない。"
  },
  {
   "id": "line077",
   "scene": "S18",
   "spk": "NA35",
   "omni": false,
   "start": 564.2456250000004,
   "end": 569.5945000000004,
   "dur": 5.348875,
   "text": "私は今、私を必要としてくれる場所で、毎日お客様を迎えている。"
  },
  {
   "id": "line078",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 588.5945000000004,
   "end": 591.3163125000004,
   "dur": 2.7218125000000004,
   "text": "ご視聴ありがとうございました。美談ものがたりです"
  },
  {
   "id": "line079",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 591.9163125000005,
   "end": 596.9604375000005,
   "dur": 5.044124999999999,
   "text": "スカッとした方は、高評価とチャンネル登録を、お願いします"
  },
  {
   "id": "line080",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 597.5604375000005,
   "end": 602.3353125000004,
   "dur": 4.774875000000001,
   "text": "皆様が若菜さんなら、月見荘に戻りますか？ コメントで教えてください"
  },
  {
   "id": "line081",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 602.9353125000005,
   "end": 608.9130625000005,
   "dur": 5.97775,
   "text": "次回は、「同窓会で私を笑った元同級生が、面接室に来た話」です"
  },
  {
   "id": "line082",
   "scene": "OUT",
   "spk": "진행자",
   "omni": false,
   "start": 609.5130625000005,
   "end": 611.3585000000005,
   "dur": 1.8454375,
   "text": "それでは、また次の物語で"
  }
 ]
}