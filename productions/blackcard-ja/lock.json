 "lines": [
  {
   "id": "line001",
   "tag": "L001",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "十五年、魂を削って尽くした会社。今朝、俺はゴミのように切り捨てられた。",
   "lead": 0.0,
   "dur": 5.215,
   "start": 2.5,
   "end": 7.715
  },
  {
   "id": "line002",
   "tag": "L002a",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "鼻で笑った上司。冷たく背を向けた妻。",
   "lead": 0.054,
   "dur": 3.306,
   "start": 8.315,
   "end": 11.621
  },
  {
   "id": "line003",
   "tag": "L002b",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "虫を見るような目で俺を見た、同期の連中。",
   "lead": 0.025,
   "dur": 3.015,
   "start": 12.221,
   "end": 15.236
  },
  {
   "id": "line004",
   "tag": "L003",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "世界が俺をどん底へ蹴り落とした、その瞬間。",
   "lead": 0.08,
   "dur": 3.084,
   "start": 15.836,
   "end": 18.92
  },
  {
   "id": "line005",
   "tag": "L004",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "雨のアスファルトで拾ったのは、残高ゼロの通帳じゃなかった。",
   "lead": 0.0,
   "dur": 4.398,
   "start": 19.52,
   "end": 23.918
  },
  {
   "id": "line006",
   "tag": "L005",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "日本の上位0.01%だけに許される。\"限度額なし\"のブラックカード。",
   "lead": 0.031,
   "dur": 5.568,
   "start": 24.518,
   "end": 30.086
  },
  {
   "id": "line007",
   "tag": "L006",
   "spk": "高橋 健二",
   "scene": "01",
   "type": "narration",
   "ja": "今夜から、あいつらに教えてやる。地獄とは、何かを。",
   "lead": 0.031,
   "dur": 4.519,
   "start": 30.686,
   "end": 35.205
  },
  {
   "id": "line008",
   "tag": "L007a",
   "spk": "柴田",
   "scene": "02",
   "type": "dialogue",
   "ja": "高橋。希望退職って形にしてやる。",
   "lead": 0.056,
   "dur": 4.1,
   "start": 38.705,
   "end": 42.805
  },
  {
   "id": "line009",
   "tag": "L007b",
   "spk": "柴田",
   "scene": "02",
   "type": "dialogue",
   "ja": "退職金は規定どおりだ。判子は――ここ。",
   "lead": 0.015,
   "dur": 3.425,
   "start": 43.405,
   "end": 46.83
  },
  {
   "id": "line010",
   "tag": "L008",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "dialogue",
   "ja": "……十五年だぞ、柴田。同期だろ。",
   "lead": 0.051,
   "dur": 2.407,
   "start": 47.63,
   "end": 50.037
  },
  {
   "id": "line011",
   "tag": "L009",
   "spk": "柴田",
   "scene": "02",
   "type": "dialogue",
   "ja": "だから、だよ。お前が隣にいると、俺の評価が下がる。",
   "lead": 0.0,
   "dur": 3.92,
   "start": 50.837,
   "end": 54.757
  },
  {
   "id": "line012",
   "tag": "L010",
   "spk": "警備員",
   "scene": "02",
   "type": "dialogue",
   "ja": "社員証は、こちらで処分いたします。私物は十八時以降、裏口の警備室でお受け取りください。",
   "lead": 0.004,
   "dur": 6.476,
   "start": 55.557,
   "end": 62.033
  },
  {
   "id": "line013",
   "tag": "L011a",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "解雇、ではない。\"希望退職\"。",
   "lead": 0.025,
   "dur": 2.573,
   "start": 62.833,
   "end": 65.406
  },
  {
   "id": "line014",
   "tag": "L011b",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "会社は、俺が自分で辞めたことにしたいらしい。",
   "lead": 0.059,
   "dur": 3.621,
   "start": 66.006,
   "end": 69.627
  },
  {
   "id": "line015",
   "tag": "L012",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "抵抗すれば、次は\"追い出し部屋\"だ。",
   "lead": 0.115,
   "dur": 2.445,
   "start": 70.227,
   "end": 72.672
  },
  {
   "id": "line016",
   "tag": "L013",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "同期の柴田は、俺より三年早く部長になった。そして今日、俺に判子を押させる側に立っていた。",
   "lead": 0.027,
   "dur": 6.293,
   "start": 73.272,
   "end": 79.565
  },
  {
   "id": "line017",
   "tag": "L014",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "ガラス越しに、部下たちが見ないふりで――全部、見ていた。",
   "lead": 0.082,
   "dur": 3.89,
   "start": 80.165,
   "end": 84.055
  },
  {
   "id": "line018",
   "tag": "L015",
   "spk": "高橋 健二",
   "scene": "02",
   "type": "narration",
   "ja": "午前十時四十五分。十五年が、紙切れ一枚で終わった。",
   "lead": 0.073,
   "dur": 4.002,
   "start": 84.655,
   "end": 88.657
  },
  {
   "id": "line019",
   "tag": "L016a",
   "spk": "美咲",
   "scene": "03",
   "type": "dialogue",
   "ja": "残高、見た？三千二百十八円。",
   "lead": 0.0,
   "dur": 3.6,
   "start": 92.157,
   "end": 95.757
  },
  {
   "id": "line020",
   "tag": "L016b",
   "spk": "美咲",
   "scene": "03",
   "type": "dialogue",
   "ja": "ローンの引き落とし、来週よ。",
   "lead": 0.033,
   "dur": 1.967,
   "start": 96.357,
   "end": 98.324
  },
  {
   "id": "line021",
   "tag": "L017",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "dialogue",
   "ja": "……話を、聞いてくれ。",
   "lead": 0.002,
   "dur": 1.755,
   "start": 99.124,
   "end": 100.879
  },
  {
   "id": "line022",
   "tag": "L018a",
   "spk": "美咲",
   "scene": "03",
   "type": "dialogue",
   "ja": "聞いたわ。四十三で、無職。",
   "lead": 0.0,
   "dur": 2.256,
   "start": 101.679,
   "end": 103.935
  },
  {
   "id": "line023",
   "tag": "L018b",
   "spk": "美咲",
   "scene": "03",
   "type": "dialogue",
   "ja": "それが全部。もう、あなたみたいな人とは暮らせない。",
   "lead": 0.014,
   "dur": 3.769,
   "start": 104.535,
   "end": 108.304
  },
  {
   "id": "line024",
   "tag": "L019",
   "spk": "美咲",
   "scene": "03",
   "type": "dialogue",
   "ja": "あなたの欄だけ、空けておいたから。判子は――ここ。",
   "lead": 0.044,
   "dur": 3.026,
   "start": 108.904,
   "end": 111.93
  },
  {
   "id": "line025",
   "tag": "L020",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "今日、二度目だ。\"判子はここ\"。",
   "lead": 0.051,
   "dur": 2.029,
   "start": 112.73,
   "end": 114.759
  },
  {
   "id": "line026",
   "tag": "L021",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "金がないということは、こういうことだ。合法的に殺されても、文句を言えない。",
   "lead": 0.001,
   "dur": 4.926,
   "start": 115.359,
   "end": 120.285
  },
  {
   "id": "line027",
   "tag": "L022",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "四十三歳。残ったのは、三十年ローンと、空っぽの口座と、俺を捨てた家族。",
   "lead": 0.026,
   "dur": 6.095,
   "start": 120.885,
   "end": 126.98
  },
  {
   "id": "line028",
   "tag": "L023",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "息ができないほどの恐怖と、腹の底から湧く、殺意に近い怒り。",
   "lead": 0.0,
   "dur": 4.612,
   "start": 127.58,
   "end": 132.192
  },
  {
   "id": "line029",
   "tag": "L024",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "世界は、弱い者の涙に一秒も目をくれない。すべてを失うまでは。",
   "lead": 0.0,
   "dur": 5.04,
   "start": 132.792,
   "end": 137.832
  },
  {
   "id": "line030",
   "tag": "L025",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "だが――その夜。あのビルの裏口、追い出された、まさにその場所で。",
   "lead": 0.042,
   "dur": 4.888,
   "start": 138.432,
   "end": 143.32
  },
  {
   "id": "line031",
   "tag": "L026",
   "spk": "高橋 健二",
   "scene": "03",
   "type": "narration",
   "ja": "つま先に当たった\"あるもの\"が、すべてを、ひっくり返した。",
   "lead": 0.0,
   "dur": 3.531,
   "start": 143.92,
   "end": 147.451
  },
  {
   "id": "line032",
   "tag": "L027a",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "narration",
   "ja": "名前がない。番号もない。",
   "lead": 0.033,
   "dur": 1.567,
   "start": 150.951,
   "end": 152.518
  },
  {
   "id": "line033",
   "tag": "L027b",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "narration",
   "ja": "ただ、裏面に、見たことのない紋章。",
   "lead": 0.028,
   "dur": 2.503,
   "start": 153.118,
   "end": 155.621
  },
  {
   "id": "line034",
   "tag": "L028",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "narration",
   "ja": "届けるべきだ。頭では、分かっていた。",
   "lead": 0.002,
   "dur": 2.387,
   "start": 156.221,
   "end": 158.608
  },
  {
   "id": "line035",
   "tag": "L029",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "narration",
   "ja": "だが、社員証をハサミで二つに切った、あの警備室に――。俺は、背を向けた。",
   "lead": 0.0,
   "dur": 5.04,
   "start": 159.208,
   "end": 164.248
  },
  {
   "id": "line036",
   "tag": "L030",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "dialogue",
   "ja": "銀座まで。",
   "lead": 0.045,
   "dur": 0.595,
   "start": 167.348,
   "end": 167.943
  },
  {
   "id": "line037",
   "tag": "L031a",
   "spk": "運転手",
   "scene": "04",
   "type": "dialogue",
   "ja": "二千三百四十円です。……はい、承認されました。",
   "lead": 0.073,
   "dur": 3.767,
   "start": 170.943,
   "end": 174.71
  },
  {
   "id": "line038",
   "tag": "L031b",
   "spk": "運転手",
   "scene": "04",
   "type": "dialogue",
   "ja": "ありがとうございました。",
   "lead": 0.057,
   "dur": 0.872,
   "start": 175.31,
   "end": 176.182
  },
  {
   "id": "line039",
   "tag": "L032",
   "spk": "高橋 健二",
   "scene": "04",
   "type": "narration",
   "ja": "二千三百四十円。たったそれだけで、心臓が、壊れそうだった。",
   "lead": 0.0,
   "dur": 4.795,
   "start": 176.982,
   "end": 181.777
  },
  {
   "id": "line040",
   "tag": "L033",
   "spk": "店員",
   "scene": "05",
   "type": "dialogue",
   "ja": "……お客様、閉店のお時間が。",
   "lead": 0.044,
   "dur": 1.955,
   "start": 185.277,
   "end": 187.232
  },
  {
   "id": "line041",
   "tag": "L034",
   "spk": "高橋 健二",
   "scene": "05",
   "type": "dialogue",
   "ja": "あれを。",
   "lead": 0.079,
   "dur": 0.597,
   "start": 188.032,
   "end": 188.629
  },
  {
   "id": "line042",
   "tag": "L035",
   "spk": "店員",
   "scene": "05",
   "type": "dialogue",
   "ja": "……こちらは、三千八百万円になりますが。",
   "lead": 0.042,
   "dur": 2.644,
   "start": 189.429,
   "end": 192.073
  },
  {
   "id": "line043",
   "tag": "L036",
   "spk": "高橋 健二",
   "scene": "05",
   "type": "dialogue",
   "ja": "カードで。",
   "lead": 0.025,
   "dur": 0.454,
   "start": 192.873,
   "end": 193.327
  },
  {
   "id": "line044",
   "tag": "L037",
   "spk": "店員",
   "scene": "05",
   "type": "dialogue",
   "ja": "……承認、されました。",
   "lead": 0.079,
   "dur": 1.281,
   "start": 196.327,
   "end": 197.608
  },
  {
   "id": "line045",
   "tag": "L038",
   "spk": "高橋 健二",
   "scene": "05",
   "type": "narration",
   "ja": "口座に一円もない男の手に、転がり込んだ。日本経済を動かす側の、\"力\"が。",
   "lead": 0.0,
   "dur": 8.0,
   "start": 200.908,
   "end": 208.908
  },
  {
   "id": "line046",
   "tag": "L039",
   "spk": "高橋 健二",
   "scene": "05",
   "type": "narration",
   "ja": "不安は、消えた。代わりに頭を満たしたのは、ただ一つ。",
   "lead": 0.065,
   "dur": 4.229,
   "start": 209.508,
   "end": 213.737
  },
  {
   "id": "line047",
   "tag": "L040",
   "spk": "高橋 健二",
   "scene": "05",
   "type": "narration",
   "ja": "\"復讐\"という名の、痺れるようなドーパミン。",
   "lead": 0.007,
   "dur": 3.176,
   "start": 214.337,
   "end": 217.513
  },
  {
   "id": "line048",
   "tag": "L041",
   "spk": "声",
   "scene": "06",
   "type": "dialogue",
   "ja": "高橋健二様。カードのご利用を、確認いたしました。",
   "lead": 0.09,
   "dur": 3.676,
   "start": 224.513,
   "end": 228.189
  },
  {
   "id": "line049",
   "tag": "L042",
   "spk": "高橋 健二",
   "scene": "06",
   "type": "dialogue",
   "ja": "……誰だ。なぜ、俺の名前を。",
   "lead": 0.128,
   "dur": 1.872,
   "start": 228.989,
   "end": 230.861
  },
  {
   "id": "line050",
   "tag": "L043a",
   "spk": "声",
   "scene": "06",
   "type": "dialogue",
   "ja": "ご質問は、お受けしておりません。ご要望だけを、お聞かせください。",
   "lead": 0.072,
   "dur": 4.088,
   "start": 231.661,
   "end": 235.749
  },
  {
   "id": "line051",
   "tag": "L043b",
   "spk": "声",
   "scene": "06",
   "type": "dialogue",
   "ja": "すべて、二十四時間以内に。",
   "lead": 0.027,
   "dur": 1.889,
   "start": 236.349,
   "end": 238.238
  },
  {
   "id": "line052",
   "tag": "L044",
   "spk": "高橋 健二",
   "scene": "06",
   "type": "dialogue",
   "ja": "……何でも、か。",
   "lead": 0.032,
   "dur": 0.608,
   "start": 239.038,
   "end": 239.646
  },
  {
   "id": "line053",
   "tag": "L045",
   "spk": "声",
   "scene": "06",
   "type": "dialogue",
   "ja": "何でも。",
   "lead": 0.041,
   "dur": 0.45,
   "start": 240.446,
   "end": 240.896
  },
  {
   "id": "line054",
   "tag": "L046",
   "spk": "高橋 健二",
   "scene": "06",
   "type": "dialogue",
   "ja": "……あのビルの、オーナーになりたい。それと、蓮見商事の株を――全部。",
   "lead": 0.078,
   "dur": 4.802,
   "start": 244.196,
   "end": 248.998
  },
  {
   "id": "line055",
   "tag": "L047",
   "spk": "声",
   "scene": "06",
   "type": "dialogue",
   "ja": "承知いたしました。",
   "lead": 0.005,
   "dur": 0.997,
   "start": 249.798,
   "end": 250.795
  },
  {
   "id": "line056",
   "tag": "L048a",
   "spk": "高橋 健二",
   "scene": "06",
   "type": "narration",
   "ja": "翌日。俺を切り捨てた男の前に立ったとき――",
   "lead": 0.042,
   "dur": 2.978,
   "start": 254.095,
   "end": 257.073
  },
  {
   "id": "line057",
   "tag": "L048b",
   "spk": "高橋 健二",
   "scene": "06",
   "type": "narration",
   "ja": "あいつが浮かべた表情を、俺は、一生、忘れない。",
   "lead": 0.037,
   "dur": 3.459,
   "start": 257.673,
   "end": 261.132
  },
  {
   "id": "line058",
   "tag": "L049",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "narration",
   "ja": "ホテルのドアの前には、体に合う仕立てのスーツと、一枚のメモ。",
   "lead": 0.121,
   "dur": 4.077,
   "start": 272.132,
   "end": 276.209
  },
  {
   "id": "line059",
   "tag": "L050",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "narration",
   "ja": "『本日十二時、最上階のレストラン。個室はご用意しております。』",
   "lead": 0.136,
   "dur": 4.024,
   "start": 276.809,
   "end": 280.833
  },
  {
   "id": "line060",
   "tag": "L051",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "narration",
   "ja": "差出人の名は、ない。",
   "lead": 0.074,
   "dur": 1.934,
   "start": 281.433,
   "end": 283.367
  },
  {
   "id": "line061",
   "tag": "L052",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "narration",
   "ja": "ニュースの片隅に、小さな見出し。『六本木ルクスタワー、所有権移転』。",
   "lead": 0.031,
   "dur": 6.162,
   "start": 286.467,
   "end": 292.629
  },
  {
   "id": "line062",
   "tag": "L053",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "narration",
   "ja": "二十四時間。あの声は、嘘をつかなかった。",
   "lead": 0.027,
   "dur": 2.983,
   "start": 293.229,
   "end": 296.212
  },
  {
   "id": "line063",
   "tag": "L054",
   "spk": "店長",
   "scene": "07",
   "type": "dialogue",
   "ja": "オーナー、お待ちしておりました。",
   "lead": 0.061,
   "dur": 1.539,
   "start": 307.012,
   "end": 308.551
  },
  {
   "id": "line064",
   "tag": "L055",
   "spk": "柴田",
   "scene": "07",
   "type": "dialogue",
   "ja": "た、高橋……？ここは、うちの予約席――",
   "lead": 0.147,
   "dur": 5.05,
   "start": 309.351,
   "end": 314.401
  },
  {
   "id": "line065",
   "tag": "L056",
   "spk": "店長",
   "scene": "07",
   "type": "dialogue",
   "ja": "本日より、こちらはオーナー様のお席となっております。",
   "lead": 0.06,
   "dur": 3.22,
   "start": 315.201,
   "end": 318.421
  },
  {
   "id": "line066",
   "tag": "L057",
   "spk": "社長",
   "scene": "07",
   "type": "dialogue",
   "ja": "……筆頭株主が、変わった？",
   "lead": 0.071,
   "dur": 1.929,
   "start": 321.721,
   "end": 323.65
  },
  {
   "id": "line067",
   "tag": "L058a",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "dialogue",
   "ja": "株は、今朝、買わせていただきました。――柴田。",
   "lead": 0.045,
   "dur": 3.117,
   "start": 324.45,
   "end": 327.567
  },
  {
   "id": "line068",
   "tag": "L058b",
   "spk": "高橋 健二",
   "scene": "07",
   "type": "dialogue",
   "ja": "座れ。",
   "lead": 0.028,
   "dur": 0.355,
   "start": 328.167,
   "end": 328.522
  },
  {
   "id": "line069",
   "tag": "L059",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "dialogue",
   "ja": "希望退職って形にしてやる。退職金は、規定どおりだ。",
   "lead": 0.098,
   "dur": 4.141,
   "start": 337.822,
   "end": 341.963
  },
  {
   "id": "line070",
   "tag": "L060",
   "spk": "柴田",
   "scene": "08",
   "type": "dialogue",
   "ja": "……待て、高橋。俺たち、同期だろ。",
   "lead": 0.04,
   "dur": 3.48,
   "start": 342.763,
   "end": 346.243
  },
  {
   "id": "line071",
   "tag": "L061",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "dialogue",
   "ja": "だから、だよ。お前が隣にいると――俺の評価が下がる。",
   "lead": 0.061,
   "dur": 3.699,
   "start": 347.043,
   "end": 350.742
  },
  {
   "id": "line072",
   "tag": "L062",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "dialogue",
   "ja": "判子は――ここ。",
   "lead": 0.07,
   "dur": 1.37,
   "start": 351.342,
   "end": 352.712
  },
  {
   "id": "line073",
   "tag": "L063",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "昨日まで俺を、犬のように使っていた男。俺の前で膝を折るまでにかかった時間は――二十四時間。",
   "lead": 0.0,
   "dur": 6.712,
   "start": 359.212,
   "end": 365.924
  },
  {
   "id": "line074",
   "tag": "L064",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "三千八百万の時計が、俺の腕で光っていた。",
   "lead": 0.002,
   "dur": 3.456,
   "start": 366.524,
   "end": 369.98
  },
  {
   "id": "line075",
   "tag": "L065",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "だが、本当に重かったのは、時計じゃない。この、紙一枚だ。",
   "lead": 0.065,
   "dur": 4.895,
   "start": 370.58,
   "end": 375.475
  },
  {
   "id": "line076",
   "tag": "L066",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "柴田が、椅子ごと後ろに崩れ落ちた。",
   "lead": 0.003,
   "dur": 2.382,
   "start": 376.075,
   "end": 378.457
  },
  {
   "id": "line077",
   "tag": "L067",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "気持ちいい、とは思わなかった。ただ、静かだった。",
   "lead": 0.0,
   "dur": 3.76,
   "start": 379.057,
   "end": 382.817
  },
  {
   "id": "line078",
   "tag": "L068",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "十五年、耳の奥で鳴り続けていた雑音が、やっと止まった。",
   "lead": 0.003,
   "dur": 4.282,
   "start": 385.817,
   "end": 390.099
  },
  {
   "id": "line079",
   "tag": "L069",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "胸がすく――という言葉の意味を、四十三年目に初めて知った。",
   "lead": 0.003,
   "dur": 5.618,
   "start": 390.699,
   "end": 396.317
  },
  {
   "id": "line080",
   "tag": "L070",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "だが、本当のクライマックスは、その夜に待っていた。",
   "lead": 0.036,
   "dur": 3.164,
   "start": 399.417,
   "end": 402.581
  },
  {
   "id": "line081",
   "tag": "L071",
   "spk": "高橋 健二",
   "scene": "08",
   "type": "narration",
   "ja": "俺を捨てた妻が――オフィスのドアを叩き壊すように開けたのだ。",
   "lead": 0.017,
   "dur": 3.811,
   "start": 403.181,
   "end": 406.992
  },
  {
   "id": "line082",
   "tag": "L072",
   "spk": "美咲",
   "scene": "09",
   "type": "dialogue",
   "ja": "健二……あなた、これ……本当、なの？",
   "lead": 0.086,
   "dur": 3.834,
   "start": 414.492,
   "end": 418.326
  },
  {
   "id": "line083",
   "tag": "L073",
   "spk": "高橋 健二",
   "scene": "09",
   "type": "dialogue",
   "ja": "ニュースは、早いな。",
   "lead": 0.04,
   "dur": 1.56,
   "start": 419.126,
   "end": 420.686
  },
  {
   "id": "line084",
   "tag": "L074",
   "spk": "美咲",
   "scene": "09",
   "type": "dialogue",
   "ja": "ねぇ、あの……離婚届、まだ出してないの。私、あのときは動揺してて――ずっと、あなたを信じて――",
   "lead": 0.232,
   "dur": 8.648,
   "start": 421.486,
   "end": 430.134
  },
  {
   "id": "line085",
   "tag": "L075a",
   "spk": "高橋 健二",
   "scene": "09",
   "type": "dialogue",
   "ja": "\"四十三で、無職。それが全部\"。",
   "lead": 0.07,
   "dur": 3.29,
   "start": 430.934,
   "end": 434.224
  },
  {
   "id": "line086",
   "tag": "L075b",
   "spk": "高橋 健二",
   "scene": "09",
   "type": "dialogue",
   "ja": "昨日の、君の言葉だ。",
   "lead": 0.085,
   "dur": 1.733,
   "start": 434.824,
   "end": 436.557
  },
  {
   "id": "line087",
   "tag": "L076",
   "spk": "美咲",
   "scene": "10",
   "type": "dialogue",
   "ja": "……これ、どこで……",
   "lead": 0.15,
   "dur": 1.929,
   "start": 443.357,
   "end": 445.286
  },
  {
   "id": "line088",
   "tag": "L077a",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "dialogue",
   "ja": "君の家族カードは、今朝止めた。慰謝料の請求書と、財産分与ゼロの協議書。",
   "lead": 0.002,
   "dur": 6.556,
   "start": 446.086,
   "end": 452.642
  },
  {
   "id": "line089",
   "tag": "L077b",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "dialogue",
   "ja": "弁護士が、全部用意してくれた。",
   "lead": 0.05,
   "dur": 1.698,
   "start": 453.242,
   "end": 454.94
  },
  {
   "id": "line090",
   "tag": "L078",
   "spk": "美咲",
   "scene": "10",
   "type": "dialogue",
   "ja": "待って、健二、お願い。一度だけ――",
   "lead": 0.072,
   "dur": 3.118,
   "start": 455.74,
   "end": 458.858
  },
  {
   "id": "line091",
   "tag": "L079",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "dialogue",
   "ja": "\"あなたの欄だけ、空けておいたから\"。",
   "lead": 0.001,
   "dur": 1.838,
   "start": 459.858,
   "end": 461.696
  },
  {
   "id": "line092",
   "tag": "L080a",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "dialogue",
   "ja": "これは、いらない。離婚は――俺の条件でする。",
   "lead": 0.0,
   "dur": 3.307,
   "start": 462.696,
   "end": 466.003
  },
  {
   "id": "line093",
   "tag": "L080b",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "dialogue",
   "ja": "判子は、ここ。",
   "lead": 0.047,
   "dur": 1.278,
   "start": 466.603,
   "end": 467.881
  },
  {
   "id": "line094",
   "tag": "L081",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "真っ白な顔で、オフィスに飛び込んできた、俺を捨てた妻。",
   "lead": 0.0,
   "dur": 3.997,
   "start": 468.481,
   "end": 472.478
  },
  {
   "id": "line095",
   "tag": "L082",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "泣きながら縋る彼女に、俺が渡したのは――離婚届じゃなかった。",
   "lead": 0.0,
   "dur": 4.07,
   "start": 473.078,
   "end": 477.148
  },
  {
   "id": "line096",
   "tag": "L083",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "彼女が隠してきた不倫の証拠と、慰謝料の請求書。",
   "lead": 0.052,
   "dur": 3.868,
   "start": 477.748,
   "end": 481.616
  },
  {
   "id": "line097",
   "tag": "L084",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "相手の名前は――柴田。",
   "lead": 0.025,
   "dur": 1.81,
   "start": 482.216,
   "end": 484.026
  },
  {
   "id": "line098",
   "tag": "L085",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "俺を切った男と、俺を捨てた女は、同じベッドで笑っていた。",
   "lead": 0.02,
   "dur": 4.38,
   "start": 484.626,
   "end": 489.006
  },
  {
   "id": "line099",
   "tag": "L086",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "他人を踏みつけて笑っていた人間に、慈悲はいらない。",
   "lead": 0.0,
   "dur": 3.92,
   "start": 489.606,
   "end": 493.526
  },
  {
   "id": "line100",
   "tag": "L087",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "俺が味わった恐怖と不安を、何倍にもして、返す。",
   "lead": 0.064,
   "dur": 4.095,
   "start": 494.126,
   "end": 498.221
  },
  {
   "id": "line101",
   "tag": "L088",
   "spk": "高橋 健二",
   "scene": "10",
   "type": "narration",
   "ja": "それが――本物の復讐だ。",
   "lead": 0.078,
   "dur": 1.755,
   "start": 498.821,
   "end": 500.576
  },
  {
   "id": "line102",
   "tag": "L089",
   "spk": "高橋 健二",
   "scene": "11",
   "type": "narration",
   "ja": "金がなければ人間以下。金があれば神になれる街――東京。",
   "lead": 0.086,
   "dur": 4.874,
   "start": 507.576,
   "end": 512.45
  },
  {
   "id": "line103",
   "tag": "L090",
   "spk": "高橋 健二",
   "scene": "11",
   "type": "narration",
   "ja": "俺はもう、底じゃない。この巨大な食物連鎖の、一番上に座っている。",
   "lead": 0.025,
   "dur": 5.735,
   "start": 513.05,
   "end": 518.785
  },
  {
   "id": "line104",
   "tag": "L091",
   "spk": "高橋 健二",
   "scene": "11",
   "type": "narration",
   "ja": "……そう、思っていた。",
   "lead": 0.067,
   "dur": 1.399,
   "start": 519.385,
   "end": 520.784
  },
  {
   "id": "line105",
   "tag": "L092a",
   "spk": "声",
   "scene": "12",
   "type": "dialogue",
   "ja": "高橋様。一点、お伝えし忘れておりました。",
   "lead": 0.042,
   "dur": 3.002,
   "start": 524.284,
   "end": 527.286
  },
  {
   "id": "line106",
   "tag": "L092b",
   "spk": "声",
   "scene": "12",
   "type": "dialogue",
   "ja": "カードの有効期限は――あと、七日です。",
   "lead": 0.048,
   "dur": 2.832,
   "start": 527.886,
   "end": 530.718
  },
  {
   "id": "line107",
   "tag": "L093",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "dialogue",
   "ja": "……七日？その後は。",
   "lead": 0.047,
   "dur": 1.473,
   "start": 531.518,
   "end": 532.991
  },
  {
   "id": "line108",
   "tag": "L094",
   "spk": "声",
   "scene": "12",
   "type": "dialogue",
   "ja": "期限の日に、精算がございます。ビルも、株も、時計も――すべて。",
   "lead": 0.0,
   "dur": 6.142,
   "start": 533.791,
   "end": 539.933
  },
  {
   "id": "line109",
   "tag": "L095",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "dialogue",
   "ja": "精算……俺に、払えと？",
   "lead": 0.005,
   "dur": 1.91,
   "start": 540.733,
   "end": 542.643
  },
  {
   "id": "line110",
   "tag": "L096",
   "spk": "声",
   "scene": "12",
   "type": "dialogue",
   "ja": "それをお決めになるのは、カードのオーナーです。期限の日に、オーナーが、お会いになります。",
   "lead": 0.065,
   "dur": 5.762,
   "start": 543.443,
   "end": 549.205
  },
  {
   "id": "line111",
   "tag": "L097",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "カードの裏の紋章。",
   "lead": 0.047,
   "dur": 1.553,
   "start": 550.005,
   "end": 551.558
  },
  {
   "id": "line112",
   "tag": "L098a",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "それは、十五年間、毎朝くぐってきたあのビルの――",
   "lead": 0.0,
   "dur": 4.48,
   "start": 554.658,
   "end": 559.138
  },
  {
   "id": "line113",
   "tag": "L098b",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "正面玄関に刻まれた紋章と、同じだった。",
   "lead": 0.0,
   "dur": 3.28,
   "start": 559.738,
   "end": 563.018
  },
  {
   "id": "line114",
   "tag": "L099",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "俺を切ったのは、本当に、あの会社だったのか。",
   "lead": 0.028,
   "dur": 3.97,
   "start": 563.618,
   "end": 567.588
  },
  {
   "id": "line115",
   "tag": "L100",
   "spk": "運転手",
   "scene": "12",
   "type": "dialogue",
   "ja": "高橋様。オーナーより、お預かりしております。",
   "lead": 0.072,
   "dur": 2.519,
   "start": 570.888,
   "end": 573.407
  },
  {
   "id": "line116",
   "tag": "L101",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "一枚の写真。十五年前、入社面接の日の俺。",
   "lead": 0.04,
   "dur": 3.546,
   "start": 576.707,
   "end": 580.253
  },
  {
   "id": "line117",
   "tag": "L102a",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "裏には、赤いスタンプ。『候補者、No.7』。",
   "lead": 0.0,
   "dur": 3.55,
   "start": 580.853,
   "end": 584.403
  },
  {
   "id": "line118",
   "tag": "L102b",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "そして――今日の日付。",
   "lead": 0.13,
   "dur": 2.356,
   "start": 585.003,
   "end": 587.359
  },
  {
   "id": "line119",
   "tag": "L103a",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "七日。七人目。",
   "lead": 0.085,
   "dur": 1.83,
   "start": 588.359,
   "end": 590.189
  },
  {
   "id": "line120",
   "tag": "L103b",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "偶然じゃない。",
   "lead": 0.0,
   "dur": 0.64,
   "start": 590.789,
   "end": 591.429
  },
  {
   "id": "line121",
   "tag": "L104",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "俺は、カードを拾ったんじゃない。十五年前から――\"選ばれていた\"。",
   "lead": 0.023,
   "dur": 5.894,
   "start": 592.029,
   "end": 597.923
  },
  {
   "id": "line122",
   "tag": "L105",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "時計が、午前零時を回った。残り――六日。",
   "lead": 0.081,
   "dur": 3.192,
   "start": 598.923,
   "end": 602.115
  },
  {
   "id": "line123",
   "tag": "L106",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "次回――十五年前、俺を\"候補者\"に選んだのは誰か。No.1からNo.6は、どこへ消えたのか。",
   "lead": 0.0,
   "dur": 7.04,
   "start": 602.715,
   "end": 609.755
  },
  {
   "id": "line124",
   "tag": "L107",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "そして期限の日。ビルと株と時計の請求書は、誰の手に渡るのか。",
   "lead": 0.009,
   "dur": 6.231,
   "start": 610.355,
   "end": 616.586
  },
  {
   "id": "line125",
   "tag": "L108",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "見逃したくない方は、チャンネル登録と通知ベルをお願いします。",
   "lead": 0.036,
   "dur": 3.724,
   "start": 617.186,
   "end": 620.91
  },
  {
   "id": "line126",
   "tag": "L109",
   "spk": "高橋 健二",
   "scene": "12",
   "type": "narration",
   "ja": "あなたなら――残り六日で、何を買い、誰に復讐しますか？コメントで、教えてください。",
   "lead": 0.04,
   "dur": 6.078,
   "start": 621.51,
   "end": 627.588
  }
 ]
