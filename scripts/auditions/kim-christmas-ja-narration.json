   "emotion_intensity": 0.8,
   "tempo": 1.0
  },
  {
   "id": "line016",
   "model": "typecast-direct",
   "voice": "tc_5d01a52563338e00072b8c9c",
   "language": "jpn",
   "text": "「わたしたちにも子どもがいたら…あなたに一度、サンタさんをやってほしかったな」",
   "emotion_preset": "sad",
   "emotion_intensity": 0.8,
   "tempo": 1.0
