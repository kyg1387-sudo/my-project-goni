   "tempo": 1.0
  },
  {
   "id": "line027",
   "model": "typecast-direct",
   "voice": "tc_65681f21097fc4326ceb5e21",
   "language": "jpn",
   "text": "そして一週間後。役員会議室で、誰も思いもよらないことが起きたのです……",
